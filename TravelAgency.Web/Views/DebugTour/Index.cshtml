@{
    ViewData["Title"] = "Отладка туров";
}

<div class="container mt-4">
    <h1 class="mb-4">Отладка загрузки туров</h1>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            <h4>Ошибка:</h4>
            <p>@ViewBag.Error</p>
        </div>
    }

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card @(ViewBag.DirectCount > 0 ? "bg-success" : "bg-danger") text-white">
                <div class="card-body text-center">
                    <h4>Прямой запрос</h4>
                    <h1>@ViewBag.DirectCount</h1>
                    <p>туров в базе</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card @(ViewBag.ServiceCount > 0 ? "bg-success" : "bg-danger") text-white">
                <div class="card-body text-center">
                    <h4>TourService</h4>
                    <h1>@ViewBag.ServiceCount</h1>
                    <p>туров через сервис</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card @(ViewBag.MappedCount > 0 ? "bg-success" : "bg-warning") text-white">
                <div class="card-body text-center">
                    <h4>Ручной маппинг</h4>
                    <h1>@ViewBag.MappedCount</h1>
                    <p>туров вручную</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>Туры из базы (прямой запрос)</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.DirectTours != null && ViewBag.DirectCount > 0)
                    {
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Название</th>
                                    <th>Цена</th>
                                    <th>Активен</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tour in ViewBag.DirectTours)
                                {
                                    <tr>
                                        <td>@tour.Id</td>
                                        <td>@tour.Title</td>
                                        <td>@tour.Price</td>
                                        <td>@tour.IsActive</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            Нет туров в базе данных
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>Туры через TourService</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.ServiceCount > 0)
                    {
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Название</th>
                                    <th>Страна</th>
                                    <th>Город</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tour in ViewBag.ServiceTours)
                                {
                                    <tr>
                                        <td>@tour.Id</td>
                                        <td>@tour.Title</td>
                                        <td>@tour.CountryName</td>
                                        <td>@tour.CityName</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="alert alert-danger">
                            <strong>TourService не возвращает туры!</strong>
                            <p class="mb-0">Проверьте логику в TourService и TourRepository</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <div class="card">
            <div class="card-header">
                <h5>Действия для отладки</h5>
            </div>
            <div class="card-body">
                <div class="btn-group">
                    <a href="/debugtour/simplelist" target="_blank" class="btn btn-primary">
                        JSON API тест
                    </a>
                    <a href="/tour" class="btn btn-secondary">
                        Основная страница туров
                    </a>
                    <button onclick="testService()" class="btn btn-info">
                        Тест через JavaScript
                    </button>
                    <a href="/debug/checkdatabase" class="btn btn-warning">
                        Проверить БД
                    </a>
                </div>

                <div class="mt-3">
                    <h6>Быстрые ссылки:</h6>
                    <a href="/api/tours" target="_blank">/api/tours</a> |
                    <a href="/test/checktours" target="_blank">/test/checktours</a> |
                    <a href="/debug/checkdatabase" target="_blank">/debug/checkdatabase</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function testService() {
        fetch('/debugtour/simplelist')
            .then(response => response.json())
            .then(data => {
                alert(`JSON API вернул: ${data.Count} туров`);
                console.log('Туры:', data.Tours);
            })
            .catch(error => {
                alert('Ошибка: ' + error);
            });
    }
</script>