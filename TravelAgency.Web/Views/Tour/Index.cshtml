@model TravelAgency.Web.Models.ViewModels.TourIndexViewModel
@{
    ViewData["Title"] = "Туры";
}

    <h1>Туры</h1>
    <p class="text-muted">Найдено туров: <strong>@Model.Tours.Count</strong></p>

    <!-- Простая форма поиска -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row">
                <div class="col-md-4 mb-2">
                    <input type="text" name="searchTerm" class="form-control"
                           placeholder="Поиск..." value="@Model.SearchTerm">
                </div>
                <div class="col-md-3 mb-2">
                    <select name="countryId" class="form-control">
                        <option value="">Все страны</option>
                        @foreach (var country in Model.Countries)
                        {
                            <option value="@country.Id"
                                    selected="@(Model.SelectedCountryId == country.Id)">
                                @country.Name
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-3 mb-2">
                    <select name="typeId" class="form-control">
                        <option value="">Все типы</option>
                        @foreach (var type in Model.TourTypes)
                        {
                            <option value="@type.Id"
                                    selected="@(Model.SelectedTypeId == type.Id)">
                                @type.Name
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-2 mb-2">
                    <button type="submit" class="btn btn-primary w-100">Найти</button>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Tours.Any())
    {
        <div class="alert alert-warning text-center py-5">
            <h4>Туры не найдены!</h4>
            <p>Попробуйте изменить параметры поиска или убедитесь, что в базе есть активные туры.</p>
            <a href="/" class="btn btn-primary">На главную</a>
            <a href="/debug/checkdatabase" class="btn btn-secondary">Проверить базу</a>
        </div>
    }
    else
    {
        <!-- Простая таблица с турами -->
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Название</th>
                        <th>Страна</th>
                        <th>Город</th>
                        <th>Цена</th>
                        <th>Дата</th>
                        <th>Дней</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tour in Model.Tours)
                    {
                        <tr>
                            <td>
                                <strong>@tour.Title</strong>
                                @if (tour.IsHotDeal)
                                {
                                    <span class="badge bg-danger ms-2">Горящий</span>
                                }
                            </td>
                            <td>@tour.CountryName</td>
                            <td>@tour.CityName</td>
                            <td>
                                <strong class="text-primary">@tour.Price.ToString("C")</strong>
                                @if (tour.DiscountPercent > 0)
                                {
                                    <br>
                                    <small class="text-success">Скидка @tour.DiscountPercent%</small>
                                }
                            </td>
                            <td>@tour.StartDate.ToString("dd.MM.yyyy")</td>
                            <td>@tour.DurationDays</td>
                            <td>
                                <a href="@Url.Action("Details", new { id = tour.Id })"
                                   class="btn btn-sm btn-primary">
                                    Подробнее
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Карточки для мобильных -->
        <div class="d-block d-md-none mt-4">
            <h4>Туры:</h4>
            @foreach (var tour in Model.Tours)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">@tour.Title</h5>
                        <p class="card-text">
                            <i class="fas fa-map-marker-alt"></i> @tour.CountryName, @tour.CityName<br>
                            <i class="fas fa-calendar"></i> @tour.StartDate.ToString("dd.MM.yyyy")<br>
                            <i class="fas fa-clock"></i> @tour.DurationDays дней<br>
                            <i class="fas fa-money-bill"></i> @tour.Price.ToString("C")
                        </p>
                        <a href="@Url.Action("Details", new { id = tour.Id })"
                           class="btn btn-primary">Подробнее</a>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .table th {
        background-color: #2c3e50;
        color: white;
    }

    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
    }

    .badge {
        font-size: 0.8em;
        padding: 0.3em 0.6em;
    }
</style>