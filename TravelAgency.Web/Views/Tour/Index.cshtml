@model TravelAgency.Web.Models.ViewModels.TourIndexViewModel
@{
    ViewData["Title"] = "Каталог туров";
}

@using System.Globalization
@{
    var belarusCulture = new CultureInfo("be-BY");
}

<div class="smooth-wrapper bg-black py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-5" data-aos="fade-up">
            <div>
                <h1 class="giant-title-mini text-white mb-0">КАТАЛОГ ТУРОВ</h1>
                <p class="text-primary-blue fw-bold mt-2">
                    <i class="fas fa-globe-americas me-2"></i>Найдено направлений: @Model.Tours.Count
                </p>
            </div>
        </div>

        <div class="card-modern p-4 mb-5 border-primary-glow" data-aos="fade-up">
            <form method="get" class="row g-3 align-items-center">
                <div class="col-md-4">
                    <div class="input-group-modern">
                        <i class="fas fa-search"></i>
                        <input type="text" name="searchTerm" class="form-control modern-input"
                               placeholder="Поиск приключения..." value="@Model.SearchTerm">
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="countryId" class="form-select modern-input select-custom">
                        <option value="">Все страны</option>
                        @foreach (var country in Model.Countries)
                        {
                            <option value="@country.Id" selected="@(Model.SelectedCountryId == country.Id)">
                                @country.Name
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="typeId" class="form-select modern-input select-custom">
                        <option value="">Любой тип тура</option>
                        @foreach (var type in Model.TourTypes)
                        {
                            <option value="@type.Id" selected="@(Model.SelectedTypeId == type.Id)">
                                @type.Name
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn-login-neon w-100 py-2">
                        <span>НАЙТИ</span>
                    </button>
                </div>
            </form>
        </div>

        @if (!Model.Tours.Any())
        {
            <div class="text-center py-5" data-aos="zoom-in">
                <div class="mb-4 opacity-25">
                    <i class="fas fa-shuttle-van display-1 text-white"></i>
                </div>
                <h3 class="text-white fw-black">МАРШРУТЫ НЕ ОБНАРУЖЕНЫ</h3>
                <p class="text-gray">Попробуйте изменить параметры фильтрации или поисковый запрос.</p>
                <a href="@Url.Action("Index")" class="btn-ultra mt-3">СБРОСИТЬ ВСЕ</a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var tour in Model.Tours)
                {
                    <div class="col-lg-6 col-xl-4" data-aos="fade-up">
                        <div class="tour-card-neon h-100">
                            <div class="card-img-container">
                                @if (!string.IsNullOrEmpty(tour.ImageUrlsJson))
                                {
                                    var images = tour.ImageUrlsJson.Trim('[', ']', '"').Split(',');
                                    <img src="@images[0].Trim()" alt="@tour.Title" onerror="this.src='/images/tours/default.jpg'">
                                }
                                <div class="card-badges">
                                    @if (tour.IsHotDeal)
                                    {
                                        <span class="badge-neon-red">HOT</span>
                                    }
                                    <span class="badge-neon-blue">@tour.TourTypeName</span>
                                </div>
                                <div class="price-float">
                                    @if (tour.DiscountPercent > 0 && tour.OriginalPrice.HasValue)
                                    {
                                        <span class="text-muted text-decoration-line-through me-2" style="font-size: 0.8rem;">
                                            @tour.OriginalPrice.Value.ToString("N0")
                                        </span>
                                    }
                                    <span class="text-primary-blue">@tour.Price.ToString("N0")</span>
                                    <span style="font-size: 0.9rem; margin-left: 2px;">BYN</span>
                                </div>
                            </div>

                            <div class="card-content">
                                <h3 class="tour-title text-white">@tour.Title</h3>
                                <div class="tour-info-grid mb-4">
                                    <div class="info-item">
                                        <i class="fas fa-map-marker-alt"></i>
                                        <span>@tour.CountryName</span>
                                    </div>
                                    <div class="info-item">
                                        <i class="fas fa-clock"></i>
                                        <span>@tour.DurationDays дн.</span>
                                    </div>
                                    <div class="info-item">
                                        <i class="fas fa-star text-warning"></i>
                                        <span>@tour.HotelCategoryName</span>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-auto">
                                    <div class="date-tag">
                                        <i class="far fa-calendar-alt me-1"></i> @tour.StartDate.ToString("dd.MM")
                                    </div>
                                    <a href="@Url.Action("Details", new { id = tour.Id })" class="btn-more">
                                        ДЕТАЛИ <i class="fas fa-chevron-right ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    .bg-black {
        background-color: #050505 !important;
    }

    .input-group-modern {
        position: relative;
        display: flex;
        align-items: center;
    }

        .input-group-modern i {
            position: absolute;
            left: 15px;
            color: rgba(255,255,255,0.3);
        }

        .input-group-modern input {
            padding-left: 45px !important;
        }

    .select-custom {
        appearance: none;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='white' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m2 5 6 6 6-6'/%3e%3c/svg%3e") !important;
        background-repeat: no-repeat !important;
        background-position: right 1rem center !important;
        background-size: 16px 12px !important;
    }

    .tour-card-neon {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 24px;
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        display: flex;
        flex-direction: column;
    }

        .tour-card-neon:hover {
            transform: translateY(-12px);
            border-color: #006aff;
            box-shadow: 0 15px 40px rgba(0, 106, 255, 0.2);
            background: rgba(255,255,255,0.05);
        }

    .card-img-container {
        position: relative;
        height: 220px;
        overflow: hidden;
    }

        .card-img-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: 0.5s;
        }

    .tour-card-neon:hover .card-img-container img {
        transform: scale(1.1);
    }

    .card-badges {
        position: absolute;
        top: 15px;
        left: 15px;
        display: flex;
        gap: 8px;
    }

    .badge-neon-red {
        background: #ff4d4d;
        color: white;
        padding: 4px 12px;
        border-radius: 100px;
        font-size: 0.7rem;
        font-weight: 900;
        box-shadow: 0 0 15px rgba(255,77,77,0.5);
    }

    .badge-neon-blue {
        background: rgba(0, 106, 255, 0.8);
        backdrop-filter: blur(5px);
        color: white;
        padding: 4px 12px;
        border-radius: 100px;
        font-size: 0.7rem;
        font-weight: 700;
    }

    .price-float {
        position: absolute;
        bottom: 15px;
        right: 15px;
        background: #fff;
        color: #000;
        padding: 6px 15px;
        border-radius: 12px;
        font-weight: 900;
        font-size: 1.1rem;
        box-shadow: 0 5px 15px rgba(0,0,0,0.3);
    }

    .card-content {
        padding: 25px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .tour-title {
        font-size: 1.25rem;
        font-weight: 800;
        margin-bottom: 15px;
        letter-spacing: -0.5px;
    }

    .tour-info-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        background: rgba(255,255,255,0.03);
        padding: 12px;
        border-radius: 15px;
    }

    .info-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 5px;
    }

        .info-item i {
            color: #006aff;
            font-size: 0.9rem;
        }

        .info-item span {
            color: rgba(255,255,255,0.6);
            font-size: 0.75rem;
            text-align: center;
        }

    .date-tag {
        color: rgba(255,255,255,0.4);
        font-size: 0.85rem;
        font-weight: 600;
    }

    .btn-more {
        color: #006aff;
        text-decoration: none;
        font-weight: 800;
        font-size: 0.8rem;
        letter-spacing: 1px;
        transition: 0.3s;
    }
    .modern-input {
        background: rgba(255, 255, 255, 0.05) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        color: white !important;
        border-radius: 12px !important;
        padding: 12px 15px;
        transition: all 0.3s ease;
    }

        .modern-input:focus {
            background: rgba(255, 255, 255, 0.08) !important;
            border-color: #006aff !important;
            box-shadow: 0 0 15px rgba(0, 106, 255, 0.3) !important;
            outline: none;
        }


        .modern-input option {
            background: #1a1a1a; 
            color: white;
        }

        .modern-input::placeholder {
            color: rgba(255, 255, 255, 0.4) !important;
        }

    .form-select, .form-control {
        box-shadow: none !important;
    }

    .card-modern {
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 20px;
    }

        .btn-more:hover {
            color: #fff;
            transform: translateX(5px);
        }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const selects = document.querySelectorAll('.select-custom');
        selects.forEach(select => {
            select.addEventListener('change', function() {
                this.closest('form').submit();
            });
        });
    });
</script>