@model TravelAgency.BLL.DTOs.TourDTO
@{
    ViewData["Title"] = Model?.Title ?? "Детали тура";
}

@using System.Globalization
@{
    var belarusCulture = new CultureInfo("be-BY");
}

<div class="smooth-wrapper bg-black py-5">
    @if (Model == null)
    {
        <div class="container text-center py-5" data-aos="zoom-in">
            <div class="error-glow-container mb-4">
                <i class="fas fa-map-marked-alt text-danger-neon display-1"></i>
            </div>
            <h2 class="text-white fw-black h1">МАРШРУТ ПОТЕРЯН</h2>
            <p class="text-gray mb-5">Запрашиваемый тур не существует или был перемещен в архив.</p>
            <a href="@Url.Action("Index")" class="btn-ultra">
                <i class="fas fa-arrow-left me-2"></i> К СПИСКУ ТУРОВ
            </a>
        </div>
    }
    else
    {
        <div class="container">

            <div class="row g-5">
                <div class="col-lg-8" data-aos="fade-right">
                    <div class="tour-header mb-4">
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <span class="tag-modern">@Model.TourTypeName</span>
                            @if (Model.IsHotDeal)
                            {
                                <span class="badge-hot-neon"><i class="fas fa-fire me-1"></i> ГОРЯЩИЙ ТУР</span>
                            }
                        </div>
                        <h1 class="giant-title-mini text-white">@Model.Title</h1>
                        <p class="text-gray lead"><i class="fas fa-map-marker-alt text-primary-blue me-2"></i>@Model.CountryName, @Model.CityName</p>
                    </div>

                    <div class="gallery-wrapper mb-5">
                        @if (!string.IsNullOrEmpty(Model.ImageUrlsJson))
                        {
                            var images = Model.ImageUrlsJson.Trim('[', ']', '"').Split(',');
                            <div class="main-image-frame mb-3">
                                <img src="@images[0].Trim()" id="mainView" class="img-fluid rounded-4" alt="@Model.Title">
                            </div>
                            <div class="thumbnails-grid d-flex gap-3">
                                @for (int i = 0; i < Math.Min(images.Length, 4); i++)
                                {
                                    <div class="thumb-item @(i == 0 ? "active" : "")" onclick="updatePreview(this, '@images[i].Trim()')">
                                        <img src="@images[i].Trim()" class="rounded-3">
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="row g-3 mb-5">
                        <div class="col-md-4">
                            <div class="card-modern p-3 text-center">
                                <i class="fas fa-calendar-alt text-primary-blue mb-2"></i>
                                <div class="small text-gray">Вылет</div>
                                <div class="text-white fw-bold">@Model.StartDate.ToString("dd MMM yyyy")</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card-modern p-3 text-center">
                                <i class="fas fa-moon text-primary-blue mb-2"></i>
                                <div class="small text-gray">Длительность</div>
                                <div class="text-white fw-bold">@Model.DurationDays ночей</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card-modern p-3 text-center">
                                <i class="fas fa-hotel text-primary-blue mb-2"></i>
                                <div class="small text-gray">Отель</div>
                                <div class="text-white fw-bold">@Model.HotelCategoryName</div>
                            </div>
                        </div>
                    </div>

                    <div class="description-section">
                        <h3 class="text-white mb-4 fw-black">ОПИСАНИЕ ТУРА</h3>
                        <div class="text-gray lead" style="line-height: 1.8;">
                            @Html.Raw(Model.Description.Replace("\n", "<br>"))
                        </div>
                    </div>
                </div>

                <div class="col-lg-4" data-aos="fade-left">
                    <div class="booking-sticky">
                        <div class="card-modern p-4 border-primary-glow">
                            <div class="price-block mb-4">
                                @if (Model.DiscountPercent > 0)
                                {
                                    <span class="text-danger text-decoration-line-through small opacity-50">@Model.OriginalPrice?.ToString("C")</span>
                                    <div class="discount-tag">-@Model.DiscountPercent%</div>
                                }
                                <div class="h1 text-white fw-black mb-0">@Model.Price.ToString("C", belarusCulture)</div>
                                <div class="text-gray small">за @(Model.MaxPeopleCount > 1 ? $"{Model.MaxPeopleCount} чел." : "человека")</div>
                            </div>

                            <form asp-controller="Booking" asp-action="Create" method="post" class="modern-form">
                                <input type="hidden" name="tourId" value="@Model.Id" />

                                <div class="mb-4">
                                    <label class="text-white small fw-bold mb-2">КОЛИЧЕСТВО ПУТЕШЕСТВЕННИКОВ</label>
                                    <select name="peopleCount" class="form-select modern-input">
                                        @for (int i = 1; i <= Math.Min(Model.AvailablePlaces ?? 10, 10); i++)
                                        {
                                            <option value="@i">@i @(i == 1 ? "человек" : "человека")</option>
                                        }
                                    </select>
                                </div>

                                <div class="status-indicator mb-4 @(Model.AvailablePlaces <= 3 ? "text-danger-neon" : "text-success-neon")">
                                    <i class="fas fa-bolt me-2"></i>
                                    @(Model.AvailablePlaces > 0 ? $"Доступно мест: {Model.AvailablePlaces}" : "Мест нет")
                                </div>

                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <button type="submit" class="btn-login-neon w-100 py-3 mb-3">ЗАБРОНИРОВАТЬ</button>
                                }
                                else
                                {
                                    <a href="@Url.Action("Login", "Account", new { returnUrl = Context.Request.Path })"
                                       class="btn-ultra w-100 justify-content-center mb-3">ВОЙТИ ДЛЯ БРОНИ</a>
                                }
                            </form>

                            <div class="text-center">
                                <span class="text-gray small"><i class="fas fa-shield-alt me-2"></i>Гарантия безопасной оплаты</span>
                            </div>
                        </div>

                        <div class="card-modern p-4 mt-4 bg-primary-gradient">
                            <h5 class="text-white fw-bold mb-3">Есть вопросы?</h5>
                            <div class="d-flex align-items-center text-white">
                                <div class="icon-circle me-3"><i class="fas fa-phone-alt"></i></div>
                                <div>
                                    <div class="small opacity-75">Круглосуточная линия</div>
                                    <div class="fw-bold">+375 (44) 796-03-06</div>
                                </div>
                            </div>
                        </div>

                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                        {
                            <div class="d-flex gap-2 mt-4">
                                <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-outline-warning w-100 rounded-pill">Правка</a>
                                <form action="@Url.Action("Delete")" method="post" class="w-100">
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <button class="btn btn-outline-danger w-100 rounded-pill" onclick="return confirm('Удалить?')">Удалить</button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .bg-black {
        background-color: #050505 !important;
    }

    .text-primary-blue {
        color: #006aff;
    }

    .text-danger-neon {
        color: #ff4d4d;
        text-shadow: 0 0 15px rgba(255,77,77,0.3);
    }

    .text-success-neon {
        color: #00ff88;
        text-shadow: 0 0 15px rgba(0,255,136,0.3);
    }

    .modern-breadcrumb {
        background: rgba(255,255,255,0.03);
        backdrop-filter: blur(10px);
        border-radius: 100px;
        border: 1px solid rgba(255,255,255,0.05);
    }

        .modern-breadcrumb a {
            color: rgba(255,255,255,0.5);
            text-decoration: none;
            transition: 0.3s;
        }

            .modern-breadcrumb a:hover {
                color: #006aff;
            }

    .card-modern {
        background: rgba(255,255,255,0.03);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 24px;
        transition: 0.3s;
    }

    .main-image-frame {
        height: 500px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 32px;
    }

        .main-image-frame img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .thumb-item {
        width: 100px;
        height: 70px;
        cursor: pointer;
        opacity: 0.5;
        transition: 0.3s;
        border-radius: 12px;
        overflow: hidden;
        border: 2px solid transparent;
    }

        .thumb-item.active, .thumb-item:hover {
            opacity: 1;
            border-color: #006aff;
        }

        .thumb-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .badge-hot-neon {
        background: linear-gradient(45deg, #ff4d4d, #f9cb28);
        padding: 6px 16px;
        border-radius: 100px;
        color: #fff;
        font-weight: 800;
        font-size: 0.75rem;
        box-shadow: 0 5px 15px rgba(255,77,77,0.4);
    }

    .modern-input {
        background: rgba(255,255,255,0.05) !important;
        border: 1px solid rgba(255,255,255,0.1) !important;
        color: #fff !important;
        border-radius: 12px !important;
        padding: 12px !important;
    }

    .booking-sticky {
        position: sticky;
        top: 100px;
    }

    .icon-circle {
        width: 45px;
        height: 45px;
        background: rgba(255,255,255,0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .bg-primary-gradient {
        background: linear-gradient(135deg, #006aff 0%, #003399 100%);
        border: none;
    }

    .discount-tag {
        display: inline-block;
        background: #ff4d4d;
        color: #fff;
        padding: 2px 8px;
        border-radius: 6px;
        font-weight: 800;
        font-size: 0.8rem;
        margin-bottom: 5px;
    }
</style>

<script>
    function updatePreview(el, src) {
        document.getElementById('mainView').src = src;
        document.querySelectorAll('.thumb-item').forEach(t => t.classList.remove('active'));
        el.classList.add('active');
    }
</script>