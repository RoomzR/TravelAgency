@model TravelAgency.BLL.DTOs.TourDTO
@{
    ViewData["Title"] = Model?.Title ?? "Детали тура";
}

@if (Model == null)
{
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm text-center p-5">
                    <div class="mb-4" style="width: 80px; height: 80px; background-color: #f8d7da; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
                        <div style="width: 40px; height: 40px; background-color: #dc3545; border-radius: 50%; position: relative;">
                        </div>
                    </div>
                    <h2 class="h3 mb-3">Тур не найден</h2>
                    <p class="text-muted mb-4">Запрашиваемый тур не существует или был удален</p>
                    <a href="@Url.Action("Index")" class="btn btn-primary px-4">
                        Вернуться к списку
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="container py-4">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb bg-light rounded-3 p-3">
                <li class="breadcrumb-item">
                    <a href="/" class="text-decoration-none text-primary">Главная</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index")" class="text-decoration-none text-primary">Туры</a>
                </li>
                <li class="breadcrumb-item active text-dark fw-semibold">@Model.Title</li>
            </ol>
        </nav>

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-4">
                            <div class="flex-grow-1 me-3">
                                <div class="d-flex align-items-center mb-2">
                                    <h1 class="h2 fw-bold mb-0 me-3">@Model.Title</h1>
                                    @if (Model.IsHotDeal)
                                    {
                                        <span class="badge bg-danger text-white px-3 py-2 rounded-3 fw-bold">
                                            ГОРЯЩИЙ ТУР
                                        </span>
                                    }
                                </div>

                                <div class="tour-meta mb-3">
                                    <span class="badge bg-primary bg-opacity-10 text-primary me-2 px-3 py-2">
                                        @Model.TourTypeName
                                    </span>
                                    <span class="badge bg-success bg-opacity-10 text-success me-2 px-3 py-2">
                                        @Model.HotelCategoryName
                                    </span>
                                    @if (Model.DiscountPercent > 0)
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2">
                                            Скидка @Model.DiscountPercent%
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="tour-pricing text-end">
                                @if (Model.DiscountPercent > 0 && Model.OriginalPrice.HasValue)
                                {
                                    <div class="original-price text-muted text-decoration-line-through mb-1">
                                        @Model.OriginalPrice.Value.ToString("C")
                                    </div>
                                }
                                <div class="current-price h2 fw-bold text-primary mb-0">
                                    @Model.Price.ToString("C")
                                </div>
                                <div class="price-per-person text-muted small">
                                    @(Model.MaxPeopleCount > 1 ? $"за {Model.MaxPeopleCount} чел." : "за человека")
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.ImageUrlsJson))
                        {
                            var images = Model.ImageUrlsJson.Trim('[', ']', '"').Split(',');
                            if (images.Length > 0)
                            {
                                <div class="tour-gallery mb-4">
                                    <div class="main-image position-relative rounded-3 overflow-hidden mb-3">
                                        <img src="@images[0].Trim()"
                                             class="img-fluid w-100 tour-main-image"
                                             alt="@Model.Title"
                                             style="height: 400px; object-fit: cover;"
                                             onerror="this.src='/images/tours/default.jpg'">
                                        @if (images.Length > 1)
                                        {
                                            <div class="image-count position-absolute bottom-0 end-0 m-3 bg-dark bg-opacity-75 text-white px-3 py-2 rounded-3">
                                                <span>+@(images.Length - 1) фото</span>
                                            </div>
                                        }
                                    </div>

                                    @if (images.Length > 1)
                                    {
                                        <div class="thumbnail-images d-flex gap-2">
                                            @for (int i = 1; i < Math.Min(images.Length, 5); i++)
                                            {
                                                <div class="thumbnail-image flex-shrink-0" style="width: 80px; height: 60px;">
                                                    <img src="@images[i].Trim()"
                                                         class="img-fluid w-100 h-100 rounded-2"
                                                         style="object-fit: cover; cursor: pointer;"
                                                         onclick="changeMainImage(this.src)"
                                                         alt="Тур @Model.Title - фото @(i + 1)">
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }

                        <div class="tour-description mb-4">
                            <h3 class="h4 mb-3 position-relative">
                                <span class="bg-white px-3">Описание тура</span>
                                <div class="position-absolute top-50 start-0 end-0 border-top z-n1"></div>
                            </h3>
                            <div class="description-content lead text-muted">
                                @Html.Raw(Model.Description.Replace("\n", "<br>"))
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="card border-start border-4 border-success h-100">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="detail-icon bg-success bg-opacity-10 text-success me-3" style="width: 50px; height: 50px; border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                                        <div style="width: 24px; height: 24px; background-color: #198754; border-radius: 50%;"></div>
                                    </div>
                                    <h4 class="h5 mb-0 fw-bold">Местонахождение</h4>
                                </div>
                                <div class="detail-list">
                                    <div class="detail-item d-flex align-items-center mb-3">
                                        <div class="me-3" style="width: 20px; height: 20px;">
                                            <div style="width: 12px; height: 12px; background-color: #198754; border-radius: 50%; margin: 4px auto;"></div>
                                        </div>
                                        <div>
                                            <strong>Страна:</strong> @Model.CountryName
                                        </div>
                                    </div>
                                    <div class="detail-item d-flex align-items-center mb-3">
                                        <div class="me-3" style="width: 20px; height: 20px;">
                                            <div style="width: 16px; height: 16px; background-color: #198754; border-radius: 3px; margin: 2px auto;"></div>
                                        </div>
                                        <div>
                                            <strong>Город:</strong> @Model.CityName
                                        </div>
                                    </div>
                                    <div class="detail-item d-flex align-items-center mb-3">
                                        <div class="me-3" style="width: 20px; height: 20px;">
                                            <div style="width: 16px; height: 12px; background-color: #198754; border-radius: 2px; margin: 4px auto;"></div>
                                        </div>
                                        <div>
                                            <strong>Отель:</strong> @Model.HotelCategoryName
                                        </div>
                                    </div>
                                    <div class="detail-item d-flex align-items-center">
                                        <div class="me-3" style="width: 20px; height: 20px;">
                                            <div style="width: 16px; height: 16px; background-color: #198754; border-radius: 2px; margin: 2px auto;"></div>
                                        </div>
                                        <div>
                                            <strong>Тип тура:</strong> @Model.TourTypeName
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card border-start border-4 border-warning h-100">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="detail-icon bg-warning bg-opacity-10 text-warning me-3" style="width: 50px; height: 50px; border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                                        <div style="width: 24px; height: 24px; background-color: #ffc107; border-radius: 4px;"></div>
                                    </div>
                                    <h4 class="h5 mb-0 fw-bold">Даты и доступность</h4>
                                </div>
                                <div class="detail-list">
                                    <div class="detail-item d-flex align-items-center mb-3">
                                        <div class="me-3" style="width: 20px; height: 20px;">
                                            <div style="width: 16px; height: 16px; background-color: #ffc107; border-radius: 50%; margin: 2px auto; position: relative;">
                                              
                                            </div>
                                        </div>
                                        <div>
                                            <strong>Дата начала:</strong> @Model.StartDate.ToString("dd.MM.yyyy")
                                        </div>
                                    </div>
                                    <div class="detail-item d-flex align-items-center mb-3">
                                        <div class="me-3" style="width: 20px; height: 20px;">
                                            <div style="width: 16px; height: 16px; background-color: #ffc107; border-radius: 3px; margin: 2px auto;"></div>
                                        </div>
                                        <div>
                                            <strong>Продолжительность:</strong> @Model.DurationDays дней
                                        </div>
                                    </div>
                                    <div class="detail-item d-flex align-items-center mb-3">
                                        <div class="me-3" style="width: 20px; height: 20px;">
                                            <div style="width: 14px; height: 14px; background-color: #ffc107; border-radius: 50%; margin: 3px auto;"></div>
                                        </div>
                                        <div>
                                            <strong>Места:</strong>
                                            <span class="availability-badge @(Model.AvailablePlaces > 0 ? "available" : "sold-out")">
                                                @Model.AvailablePlaces из @Model.MaxPeopleCount
                                            </span>
                                        </div>
                                    </div>
                                    <div class="detail-item d-flex align-items-center">
                                        <div class="me-3" style="width: 20px; height: 20px;">
                                            <div style="width: 16px; height: 16px; background-color: #ffc107; border-radius: 50%; margin: 2px auto; position: relative;">
                                            </div>
                                        </div>
                                        <div>
                                            <strong>Статус:</strong>
                                            <span class="status-badge @(Model.IsActive ? "active" : "inactive")">
                                                @(Model.IsActive ? "Активный" : "Неактивный")
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="booking-card card border-0 shadow-lg rounded-4">
                    <div class="card-header bg-gradient-primary text-white py-4 rounded-top-4">
                        <h4 class="h3 mb-0 text-center fw-bold">Бронирование</h4>
                    </div>
                    <div class="card-body p-4">
                        @if (Model.AvailablePlaces <= 0)
                        {
                            <div class="alert alert-danger border-0 mb-4">
                                <div class="d-flex align-items-center">
                                    <div class="alert-icon me-3" style="width: 24px; height: 24px; background-color: #dc3545; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                    </div>
                                    <div>
                                        <strong>Все места забронированы</strong>
                                        <p class="mb-0 small">Пожалуйста, выберите другой тур</p>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-success border-0 mb-4">
                                <div class="d-flex align-items-center">
                                    <div class="alert-icon me-3" style="width: 24px; height: 24px; background-color: #198754; border-radius: 50%; display: flex; align-items: center; justify-content: center; position: relative;">
                                  
                                    </div>
                                    <div>
                                        <strong>Доступно мест: @Model.AvailablePlaces</strong>
                                        @if (Model.AvailablePlaces <= 3)
                                        {
                                            <p class="mb-0 small text-danger fw-bold">Осталось мало мест!</p>
                                        }
                                    </div>
                                </div>
                            </div>

                            <form method="post" action="@Url.Action("Create", "Booking")" class="booking-form">
                                <input type="hidden" name="tourId" value="@Model.Id" />

                                <div class="mb-4">
                                    <label class="form-label fw-bold mb-2">
                                        Количество человек
                                    </label>
                                    <div class="people-counter">
                                        <select name="peopleCount" class="form-select form-select-lg py-3" required>
                                            @for (int i = 1; i <= Math.Min(Model.AvailablePlaces ?? 10, 10); i++)
                                            {
                                                <option value="@i">@i @(i == 1 ? "человек" : i <= 4 ? "человека" : "человек")</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-bold mb-2">
                                        Промокод
                                    </label>
                                    <div class="input-group">
                                        <input type="text"
                                               name="promoCode"
                                               class="form-control form-control-lg"
                                               placeholder="Введите промокод">
                                        <button type="button" class="btn btn-outline-primary" onclick="applyPromoCode()">
                                            Применить
                                        </button>
                                    </div>
                                </div>

                                <div class="total-price mb-4">
                                    <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded-3">
                                        <span class="fw-bold">Итого:</span>
                                        <span class="h4 fw-bold text-primary mb-0">@Model.Price.ToString("C")</span>
                                    </div>
                                </div>


                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <button type="submit" class="btn btn-primary btn-lg w-100 py-3 fw-bold mb-3">
                                        Забронировать сейчас
                                    </button>
                                }
                                else
                                {
                                    <a href="@Url.Action("Login", "Account", new { returnUrl = Context.Request.Path })"
                                       class="btn btn-primary btn-lg w-100 py-3 fw-bold mb-3">
                                        Войти для бронирования
                                    </a>
                                }
                            </form>
                        }

                        <div class="contact-info border-top pt-4">
                            <h5 class="h6 fw-bold mb-3">Нужна помощь?</h5>
                            <div class="contact-item d-flex align-items-center mb-3">
                                <div class="contact-icon bg-primary bg-opacity-10 text-primary me-3" style="width: 50px; height: 50px; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                                    <div style="width: 20px; height: 20px; background-color: #0d6efd; border-radius: 50%; position: relative;">
                                        
                                    </div>
                                </div>
                                <div>
                                    <small class="text-muted">Телефон поддержки</small>
                                    <div class="fw-bold">+375 (44) 796-03-06</div>
                                </div>
                            </div>
                            <div class="contact-item d-flex align-items-center">
                                <div class="contact-icon bg-success bg-opacity-10 text-success me-3" style="width: 50px; height: 50px; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                                    <div style="width: 20px; height: 20px; background-color: #198754; border-radius: 50%; position: relative;">
                                    </div>
                                </div>
                                <div>
                                    <small class="text-muted">Время работы</small>
                                    <div class="fw-bold">Поддержка 24/7</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.IsInRole("Manager")))
        {
            <div class="admin-actions mt-5 pt-4 border-top">
                <h5 class="h6 fw-bold mb-3 text-muted">Управление туром</h5>
                <div class="d-flex gap-2">
                    <a href="@Url.Action("Edit", new { id = Model.Id })"
                       class="btn btn-warning px-4">
                        Редактировать
                    </a>
                    <form method="post" action="@Url.Action("Delete")"
                          onsubmit="return confirmDelete()" class="d-inline">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-danger px-4">
                            Удалить
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
}

<style>
    .breadcrumb {
        background: linear-gradient(90deg, rgba(13, 110, 253, 0.1) 0%, rgba(25, 135, 84, 0.1) 100%);
        border-radius: 12px;
    }

    .badge-hot {
        font-size: 0.7rem;
        letter-spacing: 0.5px;
    }

    .tour-gallery .main-image {
        transition: transform 0.3s ease;
    }

        .tour-gallery .main-image:hover {
            transform: scale(1.01);
        }

    .thumbnail-image {
        transition: all 0.3s ease;
        border: 2px solid transparent;
    }

        .thumbnail-image:hover {
            border-color: #0d6efd;
            transform: scale(1.05);
        }

        .thumbnail-image.active {
            border-color: #0d6efd;
        }

    .availability-badge {
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
    }

        .availability-badge.available {
            background: rgba(25, 135, 84, 0.1);
            color: #198754;
        }

        .availability-badge.sold-out {
            background: rgba(220, 53, 69, 0.1);
            color: #dc3545;
        }

    .status-badge {
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
    }

        .status-badge.active {
            background: rgba(25, 135, 84, 0.1);
            color: #198754;
        }

        .status-badge.inactive {
            background: rgba(108, 117, 125, 0.1);
            color: #6c757d;
        }

    .booking-card {
        position: sticky;
        top: 20px;
        z-index: 100;
    }

    .bg-gradient-primary {
        background: linear-gradient(135deg, #0d6efd 0%, #198754 100%);
    }

    .card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1) !important;
        }

    .btn {
        transition: all 0.3s ease;
    }

        .btn:hover {
            transform: translateY(-2px);
        }

    .detail-icon {
        flex-shrink: 0;
    }

    .admin-actions {
        background: #f8f9fa;
        padding: 1.5rem;
        border-radius: 12px;
    }

    .detail-item {
        padding: 0.5rem 0;
        border-bottom: 1px solid rgba(0,0,0,0.05);
    }

        .detail-item:last-child {
            border-bottom: none;
        }
</style>

<script>
    function changeMainImage(src) {
        document.querySelector('.tour-main-image').src = src;

        document.querySelectorAll('.thumbnail-image').forEach(el => {
            el.classList.remove('active');
        });

        event.currentTarget.parentElement.classList.add('active');
    }

    function applyPromoCode() {
        const promoInput = document.querySelector('input[name="promoCode"]');
        const promoCode = promoInput.value.trim();

        if (promoCode) {
            alert('Промокод ' + promoCode + ' применен!');
        } else {
            alert('Введите промокод');
        }
    }

    function confirmDelete() {
        return confirm('Вы уверены, что хотите удалить этот тур? Это действие нельзя отменить.');
    }
</script>