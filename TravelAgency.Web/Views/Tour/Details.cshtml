@model TravelAgency.BLL.DTOs.TourDTO
@{
    ViewData["Title"] = Model?.Title ?? "Детали тура";
}

@using System.Globalization
@{
    var belarusCulture = new CultureInfo("be-BY");
}

<div class="smooth-wrapper bg-black py-5">
    @if (Model == null)
    {
        <div class="container text-center py-5" data-aos="zoom-in">
            <div class="error-glow-container mb-4">
                <i class="fas fa-map-marked-alt text-danger-neon display-1"></i>
            </div>
            <h2 class="text-white fw-black h1">МАРШРУТ ПОТЕРЯН</h2>
            <p class="text-gray mb-5">Запрашиваемый тур не существует или был перемещен в архив.</p>
            <a href="@Url.Action("Index")" class="btn-ultra">
                <i class="fas fa-arrow-left me-2"></i> К СПИСКУ ТУРОВ
            </a>
        </div>
    }
    else
    {
        <div class="container">

            <div class="row g-5">
                <div class="col-lg-8" data-aos="fade-right">
                    <div class="tour-header mb-4">
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <span class="tag-modern">@Model.TourTypeName</span>
                            @if (Model.IsHotDeal)
                            {
                                <span class="badge-hot-neon"><i class="fas fa-fire me-1"></i> ГОРЯЩИЙ ТУР</span>
                            }
                        </div>
                        <h1 class="giant-title-mini text-white">@Model.Title</h1>
                        <p class="text-gray lead"><i class="fas fa-map-marker-alt text-primary-blue me-2"></i>@Model.CountryName, @Model.CityName</p>
                    </div>

                    <div class="gallery-wrapper mb-5">
                        @if (!string.IsNullOrEmpty(Model.ImageUrlsJson))
                        {
                            var images = Model.ImageUrlsJson.Trim('[', ']', '"').Split(',');
                            <div class="main-image-frame mb-3">
                                <img src="@images[0].Trim()" id="mainView" class="img-fluid rounded-4" alt="@Model.Title">
                            </div>
                            <div class="thumbnails-grid d-flex gap-3">
                                @for (int i = 0; i < Math.Min(images.Length, 4); i++)
                                {
                                    <div class="thumb-item @(i == 0 ? "active" : "")" onclick="updatePreview(this, '@images[i].Trim()')">
                                        <img src="@images[i].Trim()" class="rounded-3">
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="row g-3 mb-5">
                        <div class="col-md-4">
                            <div class="card-modern p-3 text-center">
                                <i class="fas fa-calendar-alt text-primary-blue mb-2"></i>
                                <div class="small text-gray">Вылет</div>
                                <div class="text-white fw-bold">@Model.StartDate.ToString("dd MMM yyyy")</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card-modern p-3 text-center">
                                <i class="fas fa-moon text-primary-blue mb-2"></i>
                                <div class="small text-gray">Длительность</div>
                                <div class="text-white fw-bold">@Model.DurationDays ночей</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card-modern p-3 text-center">
                                <i class="fas fa-hotel text-primary-blue mb-2"></i>
                                <div class="small text-gray">Отель</div>
                                <div class="text-white fw-bold">@Model.HotelCategoryName</div>
                            </div>
                        </div>
                    </div>

                    <div class="description-section">
                        <h3 class="text-white mb-4 fw-black">ОПИСАНИЕ ТУРА</h3>
                        <div class="text-gray lead" style="line-height: 1.8;">
                            @Html.Raw(Model.Description.Replace("\n", "<br>"))
                        </div>
                    </div>
                </div>

                <div class="col-lg-4" data-aos="fade-left">
                    <div class="booking-sticky">
                        <div class="card-modern p-4 border-primary-glow">
                            <div class="price-block mb-4">
                                @if (Model.DiscountPercent > 0)
                                {
                                    <span class="text-danger text-decoration-line-through small opacity-50">@Model.OriginalPrice?.ToString("C")</span>
                                    <div class="discount-tag">-@Model.DiscountPercent%</div>
                                }
                                <div class="h1 text-white fw-black mb-0">@Model.Price.ToString("C", belarusCulture)</div>
                                <div class="text-gray small">за @(Model.MaxPeopleCount > 1 ? $"{Model.MaxPeopleCount} чел." : "человека")</div>
                            </div>

                            <form asp-controller="Booking" asp-action="Create" method="post" class="modern-form">
                                <input type="hidden" name="tourId" value="@Model.Id" />
                               
                               <div class="mb-4">
                                    <label class="text-white small fw-bold mb-2 text-uppercase tracking-wider">
                                        <i class="fas fa-ticket-alt text-primary-blue me-2"></i>Промокод
                                    </label>
                                    <div class="d-flex gap-2">
                                        <input type="text" id="promoInput" name="promoCode" placeholder="КОД" class="form-control modern-input promo-field flex-grow-1" />
                                        <button type="button" onclick="validatePromo()" class="btn-check-promo">
                                            <i class="fas fa-arrow-right"></i>
                                        </button>
                                    </div>
                                    <div id="promoStatus" class="extra-small mt-2 fw-bold" style="display:none; transition: 0.3s;"></div>
                                </div>
                             
                                <div class="mb-4">
                                    <label class="text-white small fw-bold mb-2">КОЛИЧЕСТВО ПУТЕШЕСТВЕННИКОВ</label>
                                    <select name="peopleCount" class="form-select modern-input">
                                        @for (int i = 1; i <= Math.Min(Model.AvailablePlaces ?? 10, 10); i++)
                                        {
                                            <option value="@i">@i @(i == 1 ? "человек" : "человека")</option>
                                        }
                                    </select>
                                </div>


                                <div class="status-indicator mb-4 @(Model.AvailablePlaces <= 3 ? "text-danger-neon" : "text-success-neon")">
                                    <i class="fas fa-bolt me-2"></i>
                                    @(Model.AvailablePlaces > 0 ? $"Доступно мест: {Model.AvailablePlaces}" : "Мест нет")
                                </div>

                                @if (TempData["ErrorMessage"] != null)
                                {
                                    <div class="alert alert-danger animate__animated animate__shakeX small py-2 mb-3">
                                        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                                    </div>
                                }

                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    @if (Model.IsAlreadyBookedByUser)
                                    {
                                        <div class="booked-status p-3 rounded-4 mb-3 text-center" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
                                            <button type="button" class="btn btn-secondary w-100 py-3 mb-2" disabled style="opacity: 0.6; border-radius: 12px; font-weight: 800;">
                                                <i class="fas fa-check-double me-2"></i>ВЫ УЖЕ ЗАБРОНИРОВАЛИ
                                            </button>
                                            <a href="@Url.Action("Index", "Booking")" class="text-primary-blue d-block text-center small text-decoration-none fw-bold">
                                                СМОТРЕТЬ В КАБИНЕТЕ <i class="fas fa-external-link-alt ms-1" style="font-size: 0.7rem;"></i>
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn-login-neon w-100 py-3 mb-3">ЗАБРОНИРОВАТЬ</button>
                                    }
                                }
                                else
                                {
                                    <a href="@Url.Action("Login", "Account", new { returnUrl = Context.Request.Path })"
                                       class="btn-auth-neon w-100 mb-3">
                                        <span class="btn-content">
                                            <i class="fas fa-sign-in-alt me-2"></i>ВОЙТИ ДЛЯ БРОНИ
                                        </span>
                                    </a>
                                }
                            </form>

                            <div class="text-center">
                                <span class="text-gray small"><i class="fas fa-shield-alt me-2"></i>Гарантия безопасной оплаты</span>
                            </div>
                        </div>

                        <div class="card-modern p-4 mt-4 bg-primary-gradient">
                            <h5 class="text-white fw-bold mb-3">Есть вопросы?</h5>
                            <div class="d-flex align-items-center text-white">
                                <div class="icon-circle me-3"><i class="fas fa-phone-alt"></i></div>
                                <div>
                                    <div class="small opacity-75">Круглосуточная линия</div>
                                    <div class="fw-bold">+375 (44) 796-03-06</div>
                                </div>
                            </div>
                        </div>

                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                        {
                            <div class="admin-actions-wrapper mt-4 p-4 rounded-4 shadow-lg border-dashed-primary">
                                <h6 class="text-primary-blue fw-black mb-3 text-uppercase small tracking-wider">
                                    <i class="fas fa-user-shield me-2"></i>Панель управления туром
                                </h6>
                                <div class="d-grid gap-3">
                                    <a asp-controller="Tour" asp-action="Edit" asp-route-id="@Model.Id" class="btn-edit-neon">
                                        <span class="btn-text"><i class="fas fa-pen-nib me-2"></i>РЕДАКТИРОВАТЬ ДАННЫЕ</span>
                                        <span class="btn-blur"></span>
                                    </a>

                                    <form asp-controller="Tour" asp-action="Delete" asp-route-id="@Model.Id" method="post"
                                          onsubmit="return confirm('ВНИМАНИЕ! Вы уверены, что хотите безвозвратно удалить этот тур?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-delete-neon w-100">
                                            <span class="btn-text"><i class="fas fa-trash-alt me-2"></i>УДАЛИТЬ ОБЪЕКТ</span>
                                            <span class="btn-blur"></span>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>

    .border-dashed-primary {
        border: 1px dashed rgba(0, 106, 255, 0.4);
        background: rgba(0, 106, 255, 0.03);
    }

    .tracking-wider {
        letter-spacing: 2px;
    }

    .btn-edit-neon, .btn-delete-neon {
        position: relative;
        padding: 14px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        font-weight: 800;
        font-size: 0.85rem;
        letter-spacing: 1px;
        transition: all 0.3s ease;
        border: none;
        overflow: hidden;
    }

    .promo-field {
        text-transform: uppercase;
        letter-spacing: 2px;
        font-weight: 700;
        border: 1px dashed rgba(0, 106, 255, 0.3) !important;
    }

        .promo-field:focus {
            border: 1px solid #006aff !important;
            background: rgba(0, 106, 255, 0.05) !important;
        }

    .promo-input-wrapper {
        position: relative;
    }

    .promo-field:not(:placeholder-shown) {
        box-shadow: 0 0 15px rgba(0, 106, 255, 0.1);
        border-style: solid !important;
    }

    .btn-edit-neon {
        background: rgba(0, 106, 255, 0.1);
        color: #006aff !important;
        border: 1px solid #006aff;
    }

        .btn-edit-neon:hover {
            background: #006aff;
            color: #fff !important;
            box-shadow: 0 0 20px rgba(0, 106, 255, 0.5);
            transform: translateY(-2px);
        }

    .btn-delete-neon {
        background: rgba(255, 77, 77, 0.1);
        color: #ff4d4d !important;
        border: 1px solid #ff4d4d;
    }

        .btn-delete-neon:hover {
            background: #ff4d4d;
            color: #fff !important;
            box-shadow: 0 0 20px rgba(255, 77, 77, 0.5);
            transform: translateY(-2px);
        }

    .btn-text {
        position: relative;
        z-index: 2;
    }

    .btn-blur {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 0;
        height: 0;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        transform: translate(-50%, -50%);
        transition: width 0.6s ease, height 0.6s ease;
    }

    .btn-edit-neon:hover .btn-blur, .btn-delete-neon:hover .btn-blur {
        width: 300px;
        height: 300px;
    }

    .btn-auth-neon {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        text-decoration: none;
        background: rgba(0, 106, 255, 0.05); 
        color: #006aff !important; 
        border: 1px solid #006aff;
        border-radius: 12px;
        font-weight: 800;
        letter-spacing: 1px;
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 1;
    }

        .btn-auth-neon::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient( 120deg, transparent, rgba(0, 106, 255, 0.2), transparent );
            transition: all 0.6s;
        }

        .btn-auth-neon:hover {
            color: #fff !important;
            background: #006aff;
            box-shadow: 0 0 20px rgba(0, 106, 255, 0.6), 0 0 40px rgba(0, 106, 255, 0.2);
            transform: translateY(-2px);
        }

            .btn-auth-neon:hover::before {
                left: 100%;
            }

        .btn-auth-neon:active {
            transform: translateY(0);
        }

    .btn-content {
        position: relative;
        z-index: 2;
    }

    .bg-black {
        background-color: #050505 !important;
    }

    .text-primary-blue {
        color: #006aff;
    }

    .text-danger-neon {
        color: #ff4d4d;
        text-shadow: 0 0 15px rgba(255,77,77,0.3);
    }

    .text-success-neon {
        color: #00ff88;
        text-shadow: 0 0 15px rgba(0,255,136,0.3);
    }

    .modern-breadcrumb {
        background: rgba(255,255,255,0.03);
        backdrop-filter: blur(10px);
        border-radius: 100px;
        border: 1px solid rgba(255,255,255,0.05);
    }

        .modern-breadcrumb a {
            color: rgba(255,255,255,0.5);
            text-decoration: none;
            transition: 0.3s;
        }

            .modern-breadcrumb a:hover {
                color: #006aff;
            }

    .card-modern {
        background: rgba(255,255,255,0.03);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 24px;
        transition: 0.3s;
    }

    .main-image-frame {
        height: 500px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 32px;
    }

        .main-image-frame img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .thumb-item {
        width: 100px;
        height: 70px;
        cursor: pointer;
        opacity: 0.5;
        transition: 0.3s;
        border-radius: 12px;
        overflow: hidden;
        border: 2px solid transparent;
    }

        .thumb-item.active, .thumb-item:hover {
            opacity: 1;
            border-color: #006aff;
        }

        .thumb-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .badge-hot-neon {
        background: linear-gradient(45deg, #ff4d4d, #f9cb28);
        padding: 6px 16px;
        border-radius: 100px;
        color: #fff;
        font-weight: 800;
        font-size: 0.75rem;
        box-shadow: 0 5px 15px rgba(255,77,77,0.4);
    }

    .modern-input {
        background: rgba(255,255,255,0.05) !important;
        border: 1px solid rgba(255,255,255,0.1) !important;
        color: #fff !important;
        border-radius: 12px !important;
        padding: 12px !important;
        cursor: pointer;
        appearance: none; 
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='%23fff'%3e%3cpath fill-rule='evenodd' d='M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z'/%3e%3c/svg%3e") !important;
        background-repeat: no-repeat !important;
        background-position: right 0.75rem center !important;
        background-size: 16px 12px !important;
    }

        .modern-input option {
            background-color: #1a1a1a; 
            color: #ffffff; 
            padding: 10px;
        }

        .modern-input:focus {
            background-color: rgba(255,255,255,0.1) !important;
            border-color: #006aff !important;
            outline: none;
            box-shadow: 0 0 0 0.25rem rgba(0, 106, 255, 0.25);
        }

    .booking-sticky {
        position: sticky;
        top: 100px;
    }

    .icon-circle {
        width: 45px;
        height: 45px;
        background: rgba(255,255,255,0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .bg-primary-gradient {
        background: linear-gradient(135deg, #006aff 0%, #003399 100%);
        border: none;
    }

    .discount-tag {
        display: inline-block;
        background: #ff4d4d;
        color: #fff;
        padding: 2px 8px;
        border-radius: 6px;
        font-weight: 800;
        font-size: 0.8rem;
        margin-bottom: 5px;
    }

    .btn-check-promo {
        background: rgba(0, 106, 255, 0.1);
        border: 1px solid #006aff;
        color: #006aff;
        border-radius: 12px;
        padding: 0 15px;
        transition: all 0.3s ease;
    }

        .btn-check-promo:hover {
            background: #006aff;
            color: white;
            box-shadow: 0 0 15px rgba(0, 106, 255, 0.5);
        }
  
    @@keyframes shakeX {
        from, to {
            transform: translate3d(0, 0, 0);
        }

        10%, 30%, 50%, 70%, 90% {
            transform: translate3d(-5px, 0, 0);
        }

        20%, 40%, 60%, 80% {
            transform: translate3d(5px, 0, 0);
        }
    }

    .animate__shakeX {
        animation: shakeX 0.5s;
    }
</style>

<script>
    function updatePreview(el, src) {
        document.getElementById('mainView').src = src;
        document.querySelectorAll('.thumb-item').forEach(t => t.classList.remove('active'));
        el.classList.add('active');
    }
    async function validatePromo() {
        const code = document.getElementById('promoInput').value;
        const tourId = '@Model.Id';
        const statusDiv = document.getElementById('promoStatus');
        const input = document.getElementById('promoInput');

        if (!code) {
            statusDiv.style.display = 'none';
            input.style.borderColor = 'rgba(255,255,255,0.1)';
            return;
        }

        try {
            const response = await fetch(`/Booking/CheckPromo?code=${code}&tourId=${tourId}`);
            const data = await response.json();

            statusDiv.style.display = 'block';

            if (data.success) {
                statusDiv.className = 'extra-small mt-2 text-success-neon animate__animated animate__fadeIn';
                statusDiv.innerHTML = `<i class="fas fa-check-circle me-1"></i> ${data.message}`;
                input.style.border = '1px solid #00ff88';
                input.style.boxShadow = '0 0 10px rgba(0, 255, 136, 0.2)';
            } else {
                statusDiv.className = 'extra-small mt-2 text-danger-neon animate__animated animate__shakeX';
                statusDiv.innerHTML = `<i class="fas fa-times-circle me-1"></i> ${data.message}`;
                input.style.border = '1px solid #ff4d4d';
                input.style.boxShadow = '0 0 10px rgba(255, 77, 77, 0.2)';
            }
        } catch (error) {
            console.error("Ошибка при проверке промокода:", error);
        }
    }
</script>