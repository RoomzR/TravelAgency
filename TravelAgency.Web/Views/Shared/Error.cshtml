@model ErrorViewModel
@{
    ViewData["Title"] = "Error | System Failure";
}

<div class="smooth-wrapper bg-black d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="container text-center">
        <div class="error-glow-container mb-5" data-aos="zoom-in">
            <div class="error-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <div class="error-pulse"></div>
        </div>

        <h1 class="giant-title-mini text-white mb-3" data-aos="fade-up">
            СИСТЕМНЫЙ <span class="text-danger-neon">СБОЙ</span>
        </h1>

        <p class="text-gray lead mb-5" data-aos="fade-up" data-aos-delay="100">
            Маршрут временно недоступен. Мы уже отправили разведывательный дрон для исправления ситуации.
        </p>

        @if (Model.ShowRequestId)
        {
            <div class="card-modern d-inline-block p-3 px-4 mb-5 border-danger-glow" data-aos="fade-up" data-aos-delay="200">
                <span class="tag-modern text-danger-neon">ID ЗАПРОСА:</span>
                <code class="text-white ms-2">@Model.RequestId</code>
            </div>
        }

        <div class="row justify-content-center mt-4" data-aos="fade-up" data-aos-delay="300">
            <div class="col-md-6">
                <div class="card-modern p-4 text-start">
                    <h3 class="h5 fw-black text-white mb-3">Режим разработчика</h3>
                    <p class="small text-gray mb-0">
                        Переключение в среду <strong class="text-white">Development</strong> отобразит подробную информацию об ошибке.
                        Это полезно для отладки, но не должно использоваться в рабочей версии.
                    </p>
                </div>
            </div>
        </div>

        <div class="mt-5" data-aos="fade-up" data-aos-delay="400">
            <a asp-controller="Home" asp-action="Index" class="btn-ultra">
                <i class="bi bi-arrow-left me-2"></i> ВЕРНУТЬСЯ НА ГЛАВНУЮ
            </a>
        </div>
    </div>
</div>

<style>
    .text-danger-neon {
        color: #ff4d4d;
        text-shadow: 0 0 30px rgba(255, 77, 77, 0.5);
    }

    .border-danger-glow {
        border-color: rgba(255, 77, 77, 0.3) !important;
    }

    .error-glow-container {
        position: relative;
        display: inline-block;
    }

    .error-icon {
        font-size: 5rem;
        color: #ff4d4d;
        position: relative;
        z-index: 2;
    }

    .error-pulse {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 100px;
        height: 100px;
        background: rgba(255, 77, 77, 0.2);
        border-radius: 50%;
        filter: blur(20px);
        animation: pulse-danger 2s infinite;
    }

    @@keyframes pulse-danger {
        0% {
            transform: translate(-50%, -50%) scale(0.8);
            opacity: 0.5;
        }

        50% {
            transform: translate(-50%, -50%) scale(1.2);
            opacity: 0.8;
        }

        100% {
            transform: translate(-50%, -50%) scale(0.8);
            opacity: 0.5;
        }
    }

    .giant-title-mini {
        font-size: clamp(2rem, 6vw, 4rem);
        font-weight: 900;
        letter-spacing: -1px;
    }

    .card-modern {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 24px;
    }

    .btn-ultra {
        background: #fff;
        color: #000;
        padding: 15px 35px;
        border-radius: 100px;
        font-weight: 800;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        transition: 0.3s;
        border: none;
    }

        .btn-ultra:hover {
            background: #ff4d4d;
            color: #fff;
            box-shadow: 0 0 30px rgba(255, 77, 77, 0.4);
            transform: translateY(-3px);
        }
</style>