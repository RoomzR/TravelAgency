@using Microsoft.AspNetCore.Identity
@using TravelAgency.DAL.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-center gap-2">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle profile-trigger" href="#" id="navbarDropdown" role="button"
               data-bs-toggle="dropdown" aria-expanded="false">
                <div class="avatar-glow">
                    <i class="fas fa-user"></i>
                </div>
                <span class="user-name-text">@User.Identity?.Name</span>
            </a>

            <ul class="dropdown-menu dropdown-menu-end modern-dropdown">
                <li class="dropdown-header text-uppercase opacity-50 small letter-spacing-2">Аккаунт</li>
                <li>
                    <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                        <i class="fas fa-id-badge me-2"></i>Профиль
                    </a>
                </li>
                @if (User.IsInRole("Client"))
                {
                    <li>
                        <a class="dropdown-item" asp-controller="Booking" asp-action="Index">
                            <i class="fas fa-suitcase me-2"></i>Бронирования
                        </a>
                    </li>
                }
                @if (User.IsInRole("Manager") || User.IsInRole("Admin") || User.IsInRole("Director"))
                {
                    <li>
                        <a class="dropdown-item" asp-controller="Booking" asp-action="ManagerPanel">
                            <i class="fas fa-tasks me-2"></i>Панель управления
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" asp-controller="Tour" asp-action="Create">
                            <i class="fas fa-plus-circle me-2"></i>Создать тур
                        </a>
                    </li>
                }

                <li><hr class="dropdown-divider"></li>
                <li>
                    <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="dropdown-item text-danger-neon">
                            <i class="fas fa-power-off me-2"></i>Выйти
                        </button>
                    </form>
                </li>
            </ul>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link btn-reg" asp-controller="Account" asp-action="Register">
                Регистрация
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link btn-login-neon" asp-controller="Account" asp-action="Login">
                ВХОД
            </a>
        </li>
    }
</ul>

<style>
    .profile-trigger {
        display: flex;
        align-items: center;
        gap: 12px;
        background: rgba(255, 255, 255, 0.03);
        padding: 6px 16px !important;
        border-radius: 100px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        transition: 0.3s !important;
    }

        .profile-trigger:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: var(--primary-blue);
        }

    .avatar-glow {
        width: 32px;
        height: 32px;
        background: var(--primary-blue);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        color: #fff;
        box-shadow: 0 0 15px rgba(0, 106, 255, 0.4);
    }

    .user-name-text {
        color: #fff;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .modern-dropdown {
        background: rgba(10, 10, 10, 0.9) !important;
        backdrop-filter: blur(20px) saturate(180%);
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        border-radius: 24px !important;
        padding: 12px !important;
        margin-top: 15px !important;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5) !important;
        min-width: 220px;
    }

        .modern-dropdown .dropdown-item {
            color: rgba(255, 255, 255, 0.7) !important;
            padding: 12px 16px !important;
            border-radius: 16px !important;
            font-weight: 500;
            transition: 0.3s;
        }

            .modern-dropdown .dropdown-item i {
                color: var(--primary-blue);
                width: 20px;
            }

            .modern-dropdown .dropdown-item:hover {
                background: rgba(0, 106, 255, 0.1) !important;
                color: #fff !important;
                transform: translateX(5px);
            }

    .text-danger-neon {
        color: #ff4d4d !important;
    }

        .text-danger-neon:hover {
            background: rgba(255, 77, 77, 0.1) !important;
        }

    .btn-reg {
        color: var(--text-gray) !important;
        font-weight: 600 !important;
        font-size: 0.9rem;
        transition: 0.3s;
    }

        .btn-reg:hover {
            color: #fff !important;
        }

    .btn-login-neon {
        background: var(--primary-blue) !important;
        color: #fff !important;
        padding: 10px 28px !important;
        border-radius: 100px !important;
        font-weight: 800 !important;
        font-size: 0.8rem;
        letter-spacing: 1px;
        box-shadow: 0 0 20px rgba(0, 106, 255, 0.3);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
    }

        .btn-login-neon:hover {
            transform: scale(1.05);
            box-shadow: 0 0 30px rgba(0, 106, 255, 0.5);
            background: #fff !important;
            color: var(--primary-blue) !important;
        }

    .letter-spacing-2 {
        letter-spacing: 2px;
    }

    @@media (max-width: 992px) {
        .profile-trigger {
            margin-top: 15px;
        }

        .btn-login-neon {
            margin-top: 10px;
            display: block;
            text-align: center;
        }
    }
</style>