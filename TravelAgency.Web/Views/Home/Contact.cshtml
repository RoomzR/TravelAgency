@{
    ViewData["Title"] = "Контакты";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <h1 class="display-4 mb-4">Свяжитесь с нами</h1>
            <p class="lead mb-5">
                Мы всегда готовы помочь вам с выбором тура или ответить на ваши вопросы.
                Свяжитесь с нами удобным для вас способом.
            </p>

            <div class="row mb-5">
                <div class="col-md-4 mb-4">
                    <div class="card border-0 shadow-sm h-100 text-center p-4">
                        <div class="mb-3">
                            <i class="fas fa-map-marker-alt fa-3x text-primary"></i>
                        </div>
                        <h4>Адрес</h4>
                        <p class="text-muted mb-0">
                            г. Москва, ул. Примерная, д. 123<br>
                            Бизнес-центр "Путешествия"
                        </p>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="card border-0 shadow-sm h-100 text-center p-4">
                        <div class="mb-3">
                            <i class="fas fa-phone fa-3x text-success"></i>
                        </div>
                        <h4>Телефон</h4>
                        <p class="text-muted mb-0">
                            +7 (495) 123-45-67<br>
                            Пн-Пт: 9:00-20:00, Сб: 10:00-18:00
                        </p>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="card border-0 shadow-sm h-100 text-center p-4">
                        <div class="mb-3">
                            <i class="fas fa-envelope fa-3x text-warning"></i>
                        </div>
                        <h4>Email</h4>
                        <p class="text-muted mb-0">
                            info@travelagency.ru<br>
                            booking@travelagency.ru
                        </p>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-6 mb-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4">
                            <h3 class="h4 mb-4">Форма обратной связи</h3>
                            <form id="contactForm">
                                <div class="mb-3">
                                    <label for="name" class="form-label">Ваше имя</label>
                                    <input type="text" class="form-control" id="name" required>
                                </div>
                                <div class="mb-3">
                                    <label for="email" class="form-label">Email</label>
                                    <input type="email" class="form-control" id="email" required>
                                </div>
                                <div class="mb-3">
                                    <label for="phone" class="form-label">Телефон</label>
                                    <input type="tel" class="form-control" id="phone">
                                </div>
                                <div class="mb-3">
                                    <label for="message" class="form-label">Сообщение</label>
                                    <textarea class="form-control" id="message" rows="4" required></textarea>
                                </div>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-paper-plane me-2"></i>Отправить сообщение
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <h3 class="h4 mb-4">Мы на карте</h3>
                            <div class="ratio ratio-16x9">
                                <div class="bg-light d-flex align-items-center justify-content-center">
                                    <div class="text-center">
                                        <i class="fas fa-map fa-3x text-muted mb-3"></i>
                                        <p class="text-muted">Карта будет здесь</p>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-4">
                                <h4 class="h5">Как добраться</h4>
                                <p class="small text-muted mb-2">
                                    <i class="fas fa-subway me-2"></i>Метро: "Центральная", выход №5
                                </p>
                                <p class="small text-muted">
                                    <i class="fas fa-bus me-2"></i>Автобусы: 101, 205, 304 до остановки "Турагентство"
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-5">
                <h3 class="h4 mb-3">Часто задаваемые вопросы</h3>
                <div class="accordion" id="faqAccordion">
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                                Какие документы нужны для бронирования тура?
                            </button>
                        </h2>
                        <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Для бронирования тура необходим паспорт. Для некоторых стран могут
                                потребоваться дополнительные документы (визы, страховки).
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                                Можно ли отменить или перенести бронирование?
                            </button>
                        </h2>
                        <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Да, отмена или перенос возможны согласно условиям договора.
                                Свяжитесь с нашим менеджером для уточнения деталей.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('contactForm').addEventListener('submit', function(e) {
            e.preventDefault();
            alert('Спасибо за ваше сообщение! Мы свяжемся с вами в ближайшее время.');
            this.reset();
        });
    </script>
}