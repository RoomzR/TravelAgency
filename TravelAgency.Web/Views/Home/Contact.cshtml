@model TravelAgency.Web.Models.ViewModels.ContactViewModel
@{
    ViewData["Title"] = "Контакты | Future of Travel";
}

<link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="smooth-wrapper bg-black">
    <section class="hero-mini">
        <div class="container text-center">
            <div class="tag-modern" data-aos="fade-up">Available 24/7</div>
            <h1 class="giant-title-mini" data-aos="fade-up" data-aos-delay="200">
                НА <span class="text-filled">СВЯЗИ</span>
            </h1>
            <p class="text-gray lead mt-3" data-aos="fade-up" data-aos-delay="300">Спланируем ваш идеальный отдых прямо сейчас</p>
        </div>
    </section>

    <div class="container pb-10">
        <div class="row g-4 mb-5">
            <div class="col-md-4" data-aos="zoom-in" data-aos-delay="100">
                <div class="card-modern text-center p-4 h-100">
                    <div class="icon-box-modern mx-auto mb-3">
                        <i class="bi bi-geo-alt text-primary-blue"></i>
                    </div>
                    <h5 class="fw-black">НАШ ОФИС</h5>
                    <p class="text-gray mb-0">г. Гомель,<br>ул. Рогачевская, 6</p>
                </div>
            </div>
            <div class="col-md-4" data-aos="zoom-in" data-aos-delay="200">
                <div class="card-modern text-center p-4 h-100 border-blue-glow">
                    <div class="icon-box-modern mx-auto mb-3">
                        <i class="bi bi-telephone text-primary-blue"></i>
                    </div>
                    <h5 class="fw-black text-white">ТЕЛЕФОН</h5>
                    <p class="text-gray mb-0">+375 (44) 796-03-06</p>
                </div>
            </div>
            <div class="col-md-4" data-aos="zoom-in" data-aos-delay="300">
                <div class="card-modern text-center p-4 h-100">
                    <div class="icon-box-modern mx-auto mb-3">
                        <i class="bi bi-envelope text-primary-blue"></i>
                    </div>
                    <h5 class="fw-black">EMAIL</h5>
                    <p class="text-gray mb-0">info@travelagency.by</p>
                </div>
            </div>
        </div>

        <div class="row g-5">
            <div class="col-lg-7" data-aos="fade-right">
                <div class="card-modern p-4 p-lg-5">
                    <h2 class="fw-black mb-4">НАПИШИТЕ НАМ</h2>
                    <form method="post" asp-action="Contact" class="row g-4">
                        @Html.AntiForgeryToken()
                        <div class="col-12">
                            <label asp-for="Name" class="tag-modern mb-2 d-block">Ваше имя</label>
                            <input asp-for="Name" class="modern-input" placeholder="Иван Иванов" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="tag-modern mb-2 d-block">Email</label>
                            <input asp-for="Email" class="modern-input" placeholder="mail@example.com" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="tag-modern mb-2 d-block">Телефон</label>
                            <input asp-for="Phone" class="modern-input" placeholder="+375..." />
                        </div>
                        <div class="col-12">
                            <label asp-for="Message" class="tag-modern mb-2 d-block">Сообщение</label>
                            <textarea asp-for="Message" class="modern-input" rows="4" placeholder="Ваш вопрос..."></textarea>
                        </div>
                        <div class="col-12 mt-5">
                            <button type="submit" class="btn-ultra w-100 justify-content-center">
                                ОТПРАВИТЬ СООБЩЕНИЕ
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" /></svg>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="col-lg-5" data-aos="fade-left">
                <h2 class="fw-black mb-4">FAQ</h2>
                <div class="modern-accordion">
                    <div class="accordion-item-v3">
                        <div class="accordion-header-v3">
                            <span>Нужна ли виза в Турцию?</span>
                        </div>
                        <div class="accordion-content-v3 text-gray">
                            Для граждан РБ виза не требуется при пребывании до 30 дней.
                        </div>
                    </div>
                </div>

                <div class="card-modern mt-5 p-4 border-blue-glow">
                    <h5 class="fw-black mb-3">ГРАФИК РАБОТЫ</h5>
                    <div class="d-flex justify-content-between text-gray">
                        <span>Пн — Пт</span>
                        <span class="text-white">09:00 — 19:00</span>
                    </div>
                    <div class="d-flex justify-content-between text-gray mt-2">
                        <span>Сб — Вс</span>
                        <span class="text-white">10:00 — 16:00</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://unpkg.com/aos@next/dist/aos.js"></script>
<script>
    AOS.init({ duration: 1000, once: false });
</script>

<style>
    :root {
        --primary-blue: #006aff;
        --bg-black: #050505;
        --text-gray: #86868b;
        --card-bg: rgba(255, 255, 255, 0.03);
    }

    .bg-black {
        background-color: var(--bg-black);
        color: #fff;
    }

    .text-gray {
        color: var(--text-gray);
    }

    .fw-black {
        font-weight: 900;
    }

    .hero-mini {
        padding: 120px 0 60px;
        background: radial-gradient(circle at center, #111 0%, #050505 100%);
    }

    .giant-title-mini {
        font-size: clamp(2.5rem, 8vw, 6rem);
        font-weight: 900;
        line-height: 1;
        letter-spacing: -2px;
    }

    .text-filled {
        color: var(--primary-blue);
        text-shadow: 0 0 40px rgba(0, 106, 255, 0.3);
    }

    .tag-modern {
        font-size: 0.75rem;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: var(--text-gray);
    }

    .card-modern {
        background: var(--card-bg);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 32px;
        transition: 0.4s ease;
    }

    .border-blue-glow {
        border-color: rgba(0, 106, 255, 0.3);
    }

    .icon-box-modern {
        font-size: 2.5rem;
        margin-bottom: 1rem;
    }

    .modern-input {
        width: 100%;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 15px 20px;
        color: #fff;
        transition: 0.3s;
    }

        .modern-input:focus {
            outline: none;
            border-color: var(--primary-blue);
            background: rgba(255, 255, 255, 0.08);
            box-shadow: 0 0 20px rgba(0, 106, 255, 0.1);
        }

    .accordion-item-v3 {
        background: var(--card-bg);
        border-radius: 20px;
        margin-bottom: 15px;
        padding: 20px;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .accordion-header-v3 {
        font-weight: 700;
        cursor: pointer;
        color: #fff;
    }

    .accordion-content-v3 {
        margin-top: 10px;
        font-size: 0.95rem;
    }

    .btn-ultra {
        background: var(--primary-blue);
        color: #fff;
        padding: 20px 40px;
        border-radius: 100px;
        font-size: 1rem;
        font-weight: 800;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 15px;
        transition: 0.4s;
        border: none;
    }

        .btn-ultra:hover {
            background: #fff;
            color: var(--primary-blue);
            transform: translateY(-3px);
        }

    .pb-10 {
        padding-bottom: 100px;
    }
</style>