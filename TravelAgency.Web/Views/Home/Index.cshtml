@model TravelAgency.Web.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Главная - Travel Agency";
}

<section class="hero-section" style="
    background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)),
                url('https://img.freepik.com/premium-photo/young-lovely-couple-sitting-with-manager-travel-agency-office-prepairing-summer-vacation_506452-3192.jpg?semt=ais_hybrid');
    background-size: cover;
    background-position: center;
    color: white;
    padding: 150px 0;
    text-align: center;
">
    <div class="container">
        <h1 class="display-4 mb-4">Откройте мир с Travel Agency</h1>
        <p class="lead mb-4">Лучшие туры по всему миру по доступным ценам</p>
        <p class="lead mb-4">Базируемся в Республике Беларусь</p>
        <a href="@Url.Action("Index", "Tour")" class="btn btn-primary btn-lg px-5 py-3">
            <i class="fas fa-search"></i> Найти тур
        </a>
    </div>
</section>

<section class="py-5 bg-light">
    <div class="container">
        <div class="row text-center">
            <div class="col-md-4 mb-4">
                <div class="stat-card p-4 rounded shadow">
                    <h2 class="display-4 text-primary">@Model.TourCount</h2>
                    <p class="text-muted">Доступных туров</p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="stat-card p-4 rounded shadow">
                    <h2 class="display-4 text-success">@Model.ClientCount</h2>
                    <p class="text-muted">Довольных клиентов</p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="stat-card p-4 rounded shadow">
                    <h2 class="display-4 text-warning">@Model.BookingCount</h2>
                    <p class="text-muted">Успешных бронирований</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row mb-4">
            <div class="col">
                <h2 class="section-title">Горящие предложения</h2>
                <p class="text-muted">Специальные цены на лучшие направления</p>
            </div>
            <div class="col text-end">
                <a href="@Url.Action("Index", "Tour")" class="btn btn-outline-primary">
                    Все туры <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="row">
            @foreach (var tour in Model.FeaturedTours)
            {
                <div class="col-md-3 mb-4">
                    <div class="card h-100 shadow-sm tour-card">
                        <div class="position-relative">
                            <img src="@(tour.ImageUrlsJson != null ?
                                                                     tour.ImageUrlsJson.Trim('[', ']', '"').Split(',')[0] :
                                                                     "/images/tours/default.jpg")"
                                 class="card-img-top"
                                 alt="@tour.Title"
                                 style="height: 200px; object-fit: cover;">
                            @if (tour.IsHotDeal)
                            {
                                <span class="position-absolute top-0 start-0 bg-danger text-white px-3 py-1 m-2 rounded">
                                    Горящий тур
                                </span>
                            }
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">@tour.Title</h5>
                            <p class="card-text text-muted small">
                                <i class="fas fa-map-marker-alt"></i> @tour.Country?.Name, @tour.City?.Name<br>
                                <i class="fas fa-calendar"></i> @tour.DurationDays дней<br>
                                <i class="fas fa-star text-warning"></i> @tour.HotelCategory?.Name
                            </p>
                            <div class="d-flex justify-content-between align-items-center">
                                <h4 class="text-primary mb-0">@tour.Price.ToString("C")</h4>
                                <a href="@Url.Action("Details", "Tour", new { id = tour.Id })"
                                   class="btn btn-sm btn-outline-primary">
                                    Подробнее
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="py-5 bg-light">
    <div class="container">
        <h2 class="section-title mb-4">Популярные направления</h2>
        <div class="row">
            @foreach (var country in Model.Countries)
            {
                <div class="col-md-4 mb-4">
                    <div class="destination-card card border-0 shadow-sm overflow-hidden">
                        <img src="@(country.ImageUrl ?? "/images/countries/default.jpg")"
                             class="card-img-top"
                             alt="@country.Name"
                             style="height: 250px; object-fit: cover;">
                        <div class="card-img-overlay d-flex align-items-end"
                             style="background: linear-gradient(transparent, rgba(0,0,0,0.7));">
                            <div>
                                <h3 class="text-white mb-1">@country.Name</h3>
                                <p class="text-light small">
                                    @(country.Description?.Length > 100 ?
                                                                    country.Description.Substring(0, 100) + "..." : country.Description)
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <h2 class="section-title text-center mb-5">Почему выбирают нас</h2>
        <div class="row">
            <div class="col-md-3 text-center mb-4">
                <div class="p-4">
                    <div class="icon-circle bg-primary text-white mb-3 mx-auto">
                        <i class="fas fa-shield-alt fa-2x"></i>
                    </div>
                    <h4>Безопасность</h4>
                    <p class="text-muted">Гарантия безопасности вашего отдыха</p>
                </div>
            </div>
            <div class="col-md-3 text-center mb-4">
                <div class="p-4">
                    <div class="icon-circle bg-success text-white mb-3 mx-auto">
                        <i class="fas fa-headset fa-2x"></i>
                    </div>
                    <h4>Поддержка 24/7</h4>
                    <p class="text-muted">Круглосуточная поддержка клиентов</p>
                </div>
            </div>
            <div class="col-md-3 text-center mb-4">
                <div class="p-4">
                    <div class="icon-circle bg-warning text-white mb-3 mx-auto">
                        <i class="fas fa-tags fa-2x"></i>
                    </div>
                    <h4>Лучшие цены</h4>
                    <p class="text-muted">Гарантия лучшей цены на рынке</p>
                </div>
            </div>
            <div class="col-md-3 text-center mb-4">
                <div class="p-4">
                    <div class="icon-circle bg-info text-white mb-3 mx-auto">
                        <i class="fas fa-award fa-2x"></i>
                    </div>
                    <h4>Опыт</h4>
                    <p class="text-muted">Более 10 лет на рынке туризма</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5 bg-light">
    <div class="container">
        <div class="row mb-4">
            <div class="col">
                <h2 class="section-title">Новости и советы</h2>
                <p class="text-muted">Полезная информация для путешественников</p>
            </div>
        </div>

        <div class="row">
            @foreach (var news in Model.NewsArticles)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <img src="@(news.ImageUrl ?? "/images/news/default.jpg")"
                             class="card-img-top"
                             alt="@news.Title"
                             style="height: 200px; object-fit: cover;">
                        <div class="card-body">
                            <small class="text-muted">@news.CreatedDate.ToString("dd.MM.yyyy")</small>
                            <h5 class="card-title mt-2">@news.Title</h5>
                            <p class="card-text">
                                @(news.Content.Length > 100 ?
                                                            news.Content.Substring(0, 100) + "..." : news.Content)
                            </p>
                            <a href="#" class="btn btn-link p-0">Читать далее →</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="py-5 text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <div class="container text-center">
        <h2 class="mb-4">Готовы к путешествию?</h2>
        <p class="lead mb-4">Забронируйте свой идеальный тур прямо сейчас</p>
        <a href="@Url.Action("Index", "Tour")" class="btn btn-light btn-lg px-5">
            Начать поиск тура
        </a>
    </div>
</section>


<footer class="border-top footer text-muted bg-light">
    <div class="container py-3">
        <div class="row">
            <div class="col-md-6">
                &copy; 2026 - TravelAgency -
                <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none">Privacy</a>
            </div>
            <div class="col-md-6 text-end">
                <span>Телефон: +375 (44) 7960306</span>
            </div>
        </div>
    </div>
</footer>

<style>
    .hero-section {
        animation: fadeIn 1s ease-in;
    }

    .section-title {
        position: relative;
        padding-bottom: 15px;
        margin-bottom: 30px;
    }

        .section-title:after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 60px;
            height: 3px;
            background: #007bff;
        }

    .stat-card {
        transition: transform 0.3s;
        background: white;
    }

        .stat-card:hover {
            transform: translateY(-5px);
        }

    .tour-card {
        transition: transform 0.3s;
        border: none;
    }

        .tour-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }

    .destination-card {
        transition: transform 0.3s;
    }

        .destination-card:hover {
            transform: scale(1.03);
        }

    .icon-circle {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }
</style>