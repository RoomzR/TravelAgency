@model TravelAgency.Web.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Travel Agency | Future of Travel";
}

<link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />

<div class="smooth-wrapper">
    <section class="hero-full">
        <div class="container-fluid p-0">
            <div class="hero-inner">
                <div class="hero-video-bg">
                    <div class="gradient-overlay"></div>
                </div>

                <div class="hero-content-center">
                    <div class="tag-modern" data-aos="fade-up">Est. 2026 — Republic of Belarus</div>
                    <h1 class="giant-title" data-aos="fade-up" data-aos-delay="200">
                        ОТКРЫВАЙ <br>
                        <span class="text-filled">ГОРИЗОНТЫ</span>
                    </h1>

                    <div class="hero-bottom-info" data-aos="fade-up" data-aos-delay="400">
                        <div class="social-proof-v2">
                            <div class="avatar-stack">
                                <img src="https://i.pravatar.cc/100?u=4" alt="u">
                                <img src="https://i.pravatar.cc/100?u=5" alt="u">
                                <img src="https://i.pravatar.cc/100?u=6" alt="u">
                                <div class="more-count">@Model.ClientCount+</div>
                            </div>
                            <p>Доверяют свой отдых нам</p>
                        </div>
                        <div class="scroll-explore">
                            <span>Scroll to explore</span>
                            <div class="mouse-icon"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-10 bg-black" id="popular">
        <div class="container-fluid px-lg-5">
            <div class="section-header-modern mb-5" data-aos="fade-right">
                <h2 class="h1 fw-black">ПОПУЛЯРНЫЕ <br> НАПРАВЛЕНИЯ</h2>
            </div>

            <div class="bento-grid-v3">
                @for (int i = 0; i < Model.Countries.Count; i++)
                {
                    var country = Model.Countries[i];
                    var delay = i * 100;
                    <div class="bento-item-v3 @(i == 0 ? "big" : i == 3 ? "wide" : "")"
                         data-aos="zoom-in-up" data-aos-delay="@delay">
                        <div class="bento-img" style="background-image: url('@(country.ImageUrl ?? "https://images.unsplash.com/photo-1469854523086-cc02fe5d8800")')"></div>
                        <div class="bento-content">
                            <span class="country-code">0@(i + 1)</span>
                            <h3 class="h4">@country.Name</h3>
                            <p class="small opacity-50">@country.Description</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
    
    <section class="py-10 overflow-hidden bg-black" id="reviews">
        <div class="container-fluid px-0">
            <div class="section-header-modern px-lg-5 mb-5" data-aos="fade-right">
                <h2 class="h1 fw-black">ЧТО ГОВОРЯТ <br> О НАС</h2>
            </div>

            @if (Model.Reviews != null && Model.Reviews.Any())
            {
                var reviews = Model.Reviews.Where(r => r.IsApproved).ToList();

                int midPoint = (int)Math.Ceiling(reviews.Count / 2.0);
                var firstRow = reviews.Take(midPoint).ToList();
                var secondRow = reviews.Skip(midPoint).ToList();

                <div class="marquee-wrapper">
                    <div class="marquee-content">
                        @foreach (var review in firstRow)
                        {
                            <div class="review-card-modern">
                                <div class="review-card-inner">
                                    <div class="review-header">
                                        <div class="review-icon">
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                                <path d="M21 12v-2a5 5 0 0 0-5-5H8a5 5 0 0 0-5 5v2"></path>
                                                <circle cx="12" cy="16" r="5"></circle>
                                                <line x1="3" y1="16" x2="5" y2="16"></line>
                                                <line x1="19" y1="16" x2="21" y2="16"></line>
                                            </svg>
                                        </div>
                                        <span class="review-tour">@review.TourTitle</span>
                                    </div>
                                    <p class="review-text">"@review.Text"</p>
                                    <div class="review-rating">
                                        @for (int i = 0; i < review.Rating; i++)
                                        {
                                            <span>★</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }

                        @foreach (var review in firstRow)
                        {
                            <div class="review-card-modern">
                                <div class="review-card-inner">
                                    <div class="review-header">
                                        <div class="review-icon">
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                                <path d="M21 12v-2a5 5 0 0 0-5-5H8a5 5 0 0 0-5 5v2"></path>
                                                <circle cx="12" cy="16" r="5"></circle>
                                                <line x1="3" y1="16" x2="5" y2="16"></line>
                                                <line x1="19" y1="16" x2="21" y2="16"></line>
                                            </svg>
                                        </div>
                                        <span class="review-tour">@review.TourTitle</span>
                                    </div>
                                    <p class="review-text">"@review.Text"</p>
                                    <div class="review-rating">
                                        @for (int i = 0; i < review.Rating; i++)
                                        {
                                            <span>★</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>


                @if (secondRow.Any())
                {
                    <div class="marquee-wrapper reverse mt-4">
                        <div class="marquee-content">
                            @foreach (var review in secondRow)
                            {
                                <div class="review-card-modern">
                                    <div class="review-card-inner">
                                        <div class="review-header">
                                            <div class="review-icon">
                                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                                    <path d="M21 12v-2a5 5 0 0 0-5-5H8a5 5 0 0 0-5 5v2"></path>
                                                    <circle cx="12" cy="16" r="5"></circle>
                                                    <line x1="3" y1="16" x2="5" y2="16"></line>
                                                    <line x1="19" y1="16" x2="21" y2="16"></line>
                                                </svg>
                                            </div>
                                            <span class="review-tour">@review.TourTitle</span>
                                        </div>
                                        <p class="review-text">"@review.Text"</p>
                                        <div class="review-rating">
                                            @for (int i = 0; i < review.Rating; i++)
                                            {
                                                <span>★</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }

                            @foreach (var review in secondRow)
                            {
                                <div class="review-card-modern">
                                    <div class="review-card-inner">
                                        <div class="review-header">
                                            <div class="review-icon">
                                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                                    <path d="M21 12v-2a5 5 0 0 0-5-5H8a5 5 0 0 0-5 5v2"></path>
                                                    <circle cx="12" cy="16" r="5"></circle>
                                                    <line x1="3" y1="16" x2="5" y2="16"></line>
                                                    <line x1="19" y1="16" x2="21" y2="16"></line>
                                                </svg>
                                            </div>
                                            <span class="review-tour">@review.TourTitle</span>
                                        </div>
                                        <p class="review-text">"@review.Text"</p>
                                        <div class="review-rating">
                                            @for (int i = 0; i < review.Rating; i++)
                                            {
                                                <span>★</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-center text-muted">Отзывов пока нет, но скоро они появятся!</p>
            }
        </div>
    </section>

    <section class="cta-full" data-aos="fade-up">
        <div class="cta-content">
            <h2 class="display-3 fw-black mb-4">ГОТОВЫ НАЧАТЬ?</h2>
            <a href="@Url.Action("Index", "Tour")" class="btn-ultra">
                ПОДОБРАТЬ ТУР
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
            </a>
        </div>
    </section>
</div>

<script src="https://unpkg.com/aos@next/dist/aos.js"></script>
<script>
    AOS.init({
        duration: 1000,
        once: false,
        mirror: true
    });
</script>

<style>
    .review-card-modern {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 24px;
        padding: 25px;
        min-width: 350px;
        margin: 0 15px;
        transition: all 0.3s ease;
    }

        .review-card-modern:hover {
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(0, 106, 255, 0.3);
            transform: translateY(-5px);
        }

    .r-top {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 15px;
    }

    .r-avatar-silhouette {
        width: 48px;
        height: 48px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--primary-blue);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .r-meta {
        flex: 1;
    }

    .r-trip {
        font-size: 0.9rem;
        color: var(--text-gray);
        letter-spacing: 0.5px;
    }

    .r-name {
        font-weight: 600;
        font-size: 1rem;
        color: #fff;
    }

    .r-text {
        font-size: 1rem;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.8);
        margin-bottom: 15px;
        font-style: italic;
    }

    .r-rating {
        display: flex;
        gap: 4px;
        color: #FFD700;
        font-size: 1.1rem;
    }

    .marquee-wrapper {
        width: 100%;
        overflow: hidden;
        position: relative;
    }

        .marquee-wrapper::before,
        .marquee-wrapper::after {
            content: '';
            position: absolute;
            top: 0;
            bottom: 0;
            width: 100px;
            z-index: 2;
            pointer-events: none;
        }

        .marquee-wrapper::before {
            left: 0;
            background: linear-gradient(to right, var(--bg-black), transparent);
        }

        .marquee-wrapper::after {
            right: 0;
            background: linear-gradient(to left, var(--bg-black), transparent);
        }

    .marquee-content {
        display: flex;
        animation: scroll 40s linear infinite;
        width: fit-content;
    }

    .marquee-wrapper.reverse .marquee-content {
        animation: scroll-reverse 40s linear infinite;
    }

    @@keyframes scroll {
        0% {
            transform: translateX(0);
        }

        100% {
            transform: translateX(-50%);
        }
    }

    @@keyframes scroll-reverse {
        0% {
            transform: translateX(-50%);
        }

        100% {
            transform: translateX(0);
        }
    }

    @@media (max-width: 768px) {
        .review-card-modern {
            min-width: 280px;
            padding: 20px;
        }

        .r-text {
            font-size: 0.9rem;
        }
    }

    :root {
        --primary-blue: #006aff;
        --bg-black: #050505;
        --text-gray: #86868b;
    }

    body {
        background-color: var(--bg-black);
        color: #fff;
        font-family: 'Inter', sans-serif;
        overflow-x: hidden;
    }

    .hero-full {
        height: 100vh;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        background: radial-gradient(circle at center, #111 0%, #050505 100%);
    }

    .hero-content-center {
        text-align: center;
        z-index: 10;
    }

    .giant-title {
        font-size: clamp(3rem, 15vw, 12rem);
        font-weight: 900;
        line-height: 0.8;
        letter-spacing: -5px;
        margin: 20px 0;
    }

    .text-filled {
        color: var(--primary-blue);
        text-shadow: 0 0 50px rgba(0, 106, 255, 0.4);
    }

    .tag-modern {
        font-size: 0.9rem;
        letter-spacing: 5px;
        text-transform: uppercase;
        color: var(--text-gray);
    }

    .hero-bottom-info {
        position: absolute;
        bottom: 50px;
        left: 0;
        right: 0;
        display: flex;
        justify-content: space-around;
        align-items: center;
        padding: 0 50px;
    }

    .social-proof-v2 {
        display: flex;
        align-items: center;
        gap: 15px;
        text-align: left;
    }

    .avatar-stack {
        display: flex;
    }

        .avatar-stack img, .more-count {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: 2px solid var(--bg-black);
            margin-left: -12px;
        }

    .more-count {
        background: var(--primary-blue);
        font-size: 0.7rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
    }

    .bento-grid-v3 {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        grid-auto-rows: 300px;
        gap: 20px;
    }

    .bento-item-v3 {
        position: relative;
        border-radius: 32px;
        overflow: hidden;
        background: #111;
        border: 1px solid rgba(255,255,255,0.05);
        transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
    }

        .bento-item-v3.big {
            grid-column: span 2;
            grid-row: span 2;
        }

        .bento-item-v3.wide {
            grid-column: span 2;
        }

    .bento-img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-size: cover;
        background-position: center;
        opacity: 0.6;
        transition: 0.8s;
    }

    .bento-item-v3:hover .bento-img {
        transform: scale(1.1);
        opacity: 0.8;
    }

    .bento-item-v3:hover {
        border-color: var(--primary-blue);
        transform: translateY(-10px);
    }

    .bento-content {
        position: absolute;
        bottom: 30px;
        left: 30px;
        right: 30px;
        z-index: 2;
    }

    .country-code {
        font-size: 0.8rem;
        color: var(--primary-blue);
        font-weight: bold;
    }

    .cta-full {
        height: 60vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(to bottom, #050505, #001a3d);
        text-align: center;
    }

    .btn-ultra {
        background: var(--primary-blue);
        color: #fff;
        padding: 25px 60px;
        border-radius: 100px;
        font-size: 1.2rem;
        font-weight: 800;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 15px;
        transition: 0.4s;
    }

        .btn-ultra:hover {
            background: #fff;
            color: var(--primary-blue);
            box-shadow: 0 0 40px rgba(255,255,255,0.2);
        }

    .mouse-icon {
        width: 25px;
        height: 40px;
        border: 2px solid var(--text-gray);
        border-radius: 20px;
        position: relative;
        margin-top: 10px;
    }

        .mouse-icon::before {
            content: '';
            position: absolute;
            left: 50%;
            top: 8px;
            width: 4px;
            height: 8px;
            background: var(--primary-blue);
            transform: translateX(-50%);
            border-radius: 2px;
            animation: scrollAnim 2s infinite;
        }

    @@keyframes scrollAnim {
        0% {
            opacity: 1;
            transform: translate(-50%, 0);
        }

        100% {
            opacity: 0;
            transform: translate(-50%, 20px);
        }
    }

    @@media (max-width: 992px) {
        .bento-grid-v3 {
            grid-template-columns: 1fr;
            grid-auto-rows: 250px;
        }

        .bento-item-v3.big, .bento-item-v3.wide {
            grid-column: span 1;
            grid-row: span 1;
        }

        .hero-bottom-info {
            flex-direction: column;
            gap: 30px;
        }
    }
</style>