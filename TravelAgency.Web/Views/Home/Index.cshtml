@model TravelAgency.Web.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Главная - Travel Agency";
}

<section class="hero-section" style="
    background: linear-gradient(135deg, rgba(13, 110, 253, 0.65) 0%, rgba(25, 135, 84, 0.65) 100%),
                url('https://img.freepik.com/premium-photo/young-lovely-couple-sitting-with-manager-travel-agency-office-prepairing-summer-vacation_506452-3192.jpg?semt=ais_hybrid');
    background-size: cover;
    background-position: center;
    color: white;
    padding: 120px 0;
    text-align: center;
    position: relative;
    overflow: hidden;
">
    <div class="container position-relative z-2">
        <div class="hero-content mx-auto" style="max-width: 800px;">
            <h1 class="display-4 fw-bold mb-4 animate-fade-in">Откройте мир с Travel Agency</h1>
            <p class="lead mb-4 fs-4 animate-fade-in-delay">Лучшие туры по всему миру по доступным ценам</p>
            <p class="lead mb-4 fs-4 animate-fade-in-delay-2">Базируемся в Республике Беларусь</p>
            <a href="@Url.Action("Index", "Tour")" class="btn btn-light btn-lg px-5 py-3 fw-bold animate-scale-in">
                Найти тур
            </a>
        </div>
    </div>
    <div class="hero-wave" style="
         position: absolute;
         bottom: 0;
         left: 0;
         right: 0;
         height: 100px;
         background: url('data:image /svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none"><path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z" fill="white"/></svg></div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row g-4 text-center">
            <div class="col-md-4">
                <div class="stat-card p-4 rounded-4 shadow-sm border border-light h-100">
                    <div class="stat-number display-5 fw-bold text-primary mb-2">@Model.TourCount</div>
                    <div class="stat-label text-muted">Доступных туров</div>
                    <div class="stat-line mt-3 mx-auto" style="width: 60px; height: 2px; background: #0d6efd;"></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card p-4 rounded-4 shadow-sm border border-light h-100">
                    <div class="stat-number display-5 fw-bold text-success mb-2">@Model.ClientCount</div>
                    <div class="stat-label text-muted">Довольных клиентов</div>
                    <div class="stat-line mt-3 mx-auto" style="width: 60px; height: 2px; background: #198754;"></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card p-4 rounded-4 shadow-sm border border-light h-100">
                    <div class="stat-number display-5 fw-bold text-warning mb-2">@Model.BookingCount</div>
                    <div class="stat-label text-muted">Успешных бронирований</div>
                    <div class="stat-line mt-3 mx-auto" style="width: 60px; height: 2px; background: #ffc107;"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5 bg-light-subtle">
    <div class="container">
        <div class="section-header mb-5">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="h1 fw-bold text-primary mb-2">Горящие предложения</h2>
                    <p class="text-muted mb-0">Специальные цены на лучшие направления</p>
                </div>
                <a href="@Url.Action("Index", "Tour")" class="btn btn-outline-primary btn-lg">
                    Все туры →
                </a>
            </div>
        </div>

        <div class="row g-4">
            @foreach (var tour in Model.FeaturedTours)
            {
                <div class="col-md-3">
                    <div class="card tour-card border-0 shadow-sm h-100 overflow-hidden">
                        <div class="tour-image-wrapper position-relative">
                            <img src="@(tour.ImageUrlsJson != null ? tour.ImageUrlsJson.Trim('[', ']', '"').Split(',')[0] : "/images/tours/default.jpg")"
                                 class="card-img-top"
                                 alt="@tour.Title"
                                 style="height: 250px; object-fit: cover;">
                            @if (tour.IsHotDeal)
                            {
                                <div class="hot-badge position-absolute top-0 start-0 bg-danger text-white px-3 py-2 m-3 rounded-2">
                                    <strong>Горящий</strong>
                                </div>
                            }
                            <div class="tour-overlay position-absolute bottom-0 start-0 end-0 p-3 text-white"
                                 style="background: linear-gradient(transparent, rgba(0,0,0,0.8));">
                                <div class="tour-location small">@tour.Country?.Name, @tour.City?.Name</div>
                            </div>
                        </div>
                        <div class="card-body p-4">
                            <h5 class="card-title fw-bold mb-3">@tour.Title</h5>
                            <div class="tour-details mb-3">
                                <div class="d-flex align-items-center mb-2">
                                    <span class="badge bg-light text-dark me-2">📅 @tour.DurationDays дн.</span>
                                    <span class="badge bg-light text-dark">⭐ @tour.HotelCategory?.Name</span>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                <div>
                                    <div class="tour-price-old text-muted text-decoration-line-through small">
                                        @((tour.Price * 1.2m).ToString("C"))
                                    </div>
                                    <div class="tour-price-new h4 text-primary fw-bold mb-0">@tour.Price.ToString("C")</div>
                                </div>
                                <a href="@Url.Action("Details", "Tour", new { id = tour.Id })"
                                   class="btn btn-primary btn-sm px-3 py-2">
                                    Подробнее
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="section-header text-center mb-5">
            <h2 class="h1 fw-bold text-primary mb-3">Популярные направления</h2>
            <p class="lead text-muted mx-auto" style="max-width: 700px;">
                Откройте для себя самые востребованные направления для путешествий
            </p>
        </div>

        <div class="row g-4">
            @foreach (var country in Model.Countries)
            {
                <div class="col-md-4">
                    <div class="destination-card card border-0 overflow-hidden shadow-hover h-100">
                        <div class="position-relative">
                            <img src="@(country.ImageUrl ?? "/images/countries/default.jpg")"
                                 class="card-img-top destination-image"
                                 alt="@country.Name"
                                 style="height: 300px; object-fit: cover;">
                            <div class="destination-overlay"></div>
                            <div class="destination-content position-absolute bottom-0 start-0 end-0 p-4 text-white">
                                <h3 class="h4 fw-bold mb-2">@country.Name</h3>
                                <p class="mb-0 small opacity-90">
                                    @(country.Description?.Length > 80 ? country.Description.Substring(0, 80) + "..." : country.Description)
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="py-5 bg-light-subtle">
    <div class="container">
        <div class="section-header text-center mb-5">
            <h2 class="h1 fw-bold text-primary mb-3">Почему выбирают нас</h2>
            <p class="lead text-muted mx-auto" style="max-width: 700px;">
                Наши ключевые преимущества, которые делают путешествие с нами особенным
            </p>
        </div>

        <div class="row g-4 justify-content-center">
            <div class="col-md-3">
                <div class="benefit-card text-center p-4">
                    <div class="benefit-icon-img mb-4 mx-auto">
                        <img src="/images/icons/shield.png" alt="Безопасность" class="img-fluid"
                             style="width: 80px; height: 80px; object-fit: contain;">
                    </div>
                    <h4 class="h5 fw-bold mb-3">Безопасность</h4>
                    <p class="text-muted mb-0">Гарантия безопасности вашего отдыха</p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="benefit-card text-center p-4">
                    <div class="benefit-icon-img mb-4 mx-auto">
                        <img src="/images/icons/support.png" alt="Поддержка 24/7" class="img-fluid"
                             style="width: 80px; height: 80px; object-fit: contain;">
                    </div>
                    <h4 class="h5 fw-bold mb-3">Поддержка 24/7</h4>
                    <p class="text-muted mb-0">Круглосуточная поддержка клиентов</p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="benefit-card text-center p-4">
                    <div class="benefit-icon-img mb-4 mx-auto">
                        <img src="/images/icons/price-tag.png" alt="Лучшие цены" class="img-fluid"
                             style="width: 80px; height: 80px; object-fit: contain;">
                    </div>
                    <h4 class="h5 fw-bold mb-3">Лучшие цены</h4>
                    <p class="text-muted mb-0">Гарантия лучшей цены на рынке</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="section-header mb-5">
            <h2 class="h1 fw-bold text-primary mb-3">Новости и советы</h2>
            <p class="text-muted">Полезная информация для путешественников</p>
        </div>

        <div class="row g-4">
            @foreach (var news in Model.NewsArticles)
            {
                <div class="col-md-4">
                    <div class="card news-card border-0 shadow-sm h-100 overflow-hidden">
                        <div class="news-image-wrapper position-relative">
                            <img src="@(news.ImageUrl ?? "/images/news/default.jpg")"
                                 class="card-img-top"
                                 alt="@news.Title"
                                 style="height: 200px; object-fit: cover;">
                            <div class="news-date position-absolute top-0 end-0 bg-primary text-white px-3 py-2 m-3 rounded-2">
                                <strong>@news.CreatedDate.ToString("dd.MM")</strong>
                            </div>
                        </div>
                        <div class="card-body p-4">
                            <h5 class="card-title fw-bold mb-3">@news.Title</h5>
                            <p class="card-text text-muted mb-4">
                                @(news.Content.Length > 120 ? news.Content.Substring(0, 120) + "..." : news.Content)
                            </p>
                            <a href="#" class="btn btn-link text-primary fw-bold p-0">
                                Читать далее →
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="py-5 text-white" style="background: linear-gradient(135deg, #0d6efd 0%, #198754 100%);">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h2 class="h1 fw-bold mb-3">Готовы к путешествию?</h2>
                <p class="lead mb-0">Забронируйте свой идеальный тур прямо сейчас</p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <a href="@Url.Action("Index", "Tour")" class="btn btn-light btn-lg px-5 py-3 fw-bold">
                    Начать поиск тура
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    .animate-fade-in {
        animation: fadeIn 1s ease-out;
    }

    .animate-fade-in-delay {
        animation: fadeIn 1s ease-out 0.3s both;
    }

    .animate-fade-in-delay-2 {
        animation: fadeIn 1s ease-out 0.6s both;
    }

    .animate-scale-in {
        animation: scaleIn 0.5s ease-out 0.9s both;
    }

    .stat-card {
        transition: all 0.3s ease;
        background: white;
    }

        .stat-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1) !important;
        }

    .tour-card {
        transition: all 0.3s ease;
    }

        .tour-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.15) !important;
        }

    .tour-image-wrapper::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(to bottom, transparent 50%, rgba(0,0,0,0.3) 100%);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .tour-card:hover .tour-image-wrapper::after {
        opacity: 1;
    }

    .destination-card {
        transition: all 0.3s ease;
    }

        .destination-card:hover {
            transform: scale(1.02);
        }

    .destination-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(to bottom, transparent 50%, rgba(0,0,0,0.7) 100%);
    }

    .benefit-card {
        transition: all 0.3s ease;
    }

        .benefit-card:hover {
            transform: translateY(-5px);
        }

    .benefit-icon {
        width: 80px;
        height: 80px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .news-card {
        transition: all 0.3s ease;
    }

        .news-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1) !important;
        }

    .bg-light-subtle {
        background-color: #f8f9fa !important;
    }

    .shadow-hover {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .shadow-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1) !important;
        }

    .section-header {
        position: relative;
        padding-bottom: 20px;
    }

        .section-header::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 60px;
            height: 3px;
            background: linear-gradient(90deg, #0d6efd, #198754);
        }

        .section-header.text-center::after {
            left: 50%;
            transform: translateX(-50%);
        }
</style>