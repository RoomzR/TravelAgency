@{
    ViewData["Title"] = "О компании";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <!-- Заголовок с декоративной линией -->
            <div class="text-center mb-5">
                <h1 class="display-5 fw-bold mb-3 text-primary">О компании Travel Agency</h1>
                <div class="divider mx-auto" style="width: 80px; height: 3px; background: linear-gradient(90deg, #0d6efd, #198754);"></div>
            </div>

            <!-- Блок истории -->
            <div class="card border-0 bg-light-subtle rounded-4 p-4 p-lg-5 mb-5 shadow-sm">
                <h2 class="h2 mb-4 position-relative">
                    <span class="bg-white px-3">Наша история</span>
                    <div class="position-absolute top-50 start-0 end-0 border-top z-n1"></div>
                </h2>
                <p class="fs-5 text-muted mb-0">
                    Travel Agency была основана в 2026 году с целью сделать путешествия доступными
                    и незабываемыми для каждого. За это время мы активно развиваемся и получаем только положительные отзывы от наших клиентов.
                </p>
            </div>

            <!-- Миссия и видение в карточках -->
            <div class="row g-4 mb-5">
                <div class="col-lg-6">
                    <div class="card h-100 border-start border-4 border-primary shadow-hover">
                        <div class="card-body p-4 p-lg-5">
                            <div class="d-flex align-items-center mb-3">
                                <div class="square-icon bg-primary bg-opacity-10 text-primary">М</div>
                                <h3 class="h4 ms-3 mb-0">Наша миссия</h3>
                            </div>
                            <p class="card-text">
                                Создавать уникальные путешествия, которые вдохновляют, обогащают
                                и остаются в памяти навсегда. Мы стремимся к тому, чтобы каждый
                                наш клиент чувствовал заботу и внимание на всех этапах путешествия.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="card h-100 border-start border-4 border-success shadow-hover">
                        <div class="card-body p-4 p-lg-5">
                            <div class="d-flex align-items-center mb-3">
                                <div class="square-icon bg-success bg-opacity-10 text-success">В</div>
                                <h3 class="h4 ms-3 mb-0">Наше видение</h3>
                            </div>
                            <p class="card-text">
                                Стать ведущим туристическим агентством, предлагающим инновационные
                                решения и превосходный сервис. Мы постоянно развиваемся и
                                адаптируемся к меняющимся потребностям современных путешественников.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Ценности -->
            <div class="mb-5">
                <h2 class="h2 mb-4 text-center">Наши ценности</h2>
                <div class="row g-4">
                    <div class="col-md-4">
                        <div class="card border-0 text-center h-100 p-4 shadow-hover">
                            <div class="value-number mb-3">01</div>
                            <h4 class="h5 mb-3">Надежность</h4>
                            <p class="text-muted small">Мы выполняем свои обещания и гарантируем качество каждого тура</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-0 text-center h-100 p-4 shadow-hover">
                            <div class="value-number mb-3">02</div>
                            <h4 class="h5 mb-3">Забота</h4>
                            <p class="text-muted small">Клиент всегда на первом месте. Индивидуальный подход к каждому</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-0 text-center h-100 p-4 shadow-hover">
                            <div class="value-number mb-3">03</div>
                            <h4 class="h5 mb-3">Инновации</h4>
                            <p class="text-muted small">Постоянное развитие и внедрение новых технологий в туризме</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Команда -->
            <div class="card border-0 bg-gradient-custom rounded-4 p-4 p-lg-5 mb-5 text-white">
                <h2 class="h2 mb-4">Наша команда</h2>
                <p class="fs-5 mb-0">
                    Наша команда состоит из опытных профессионалов - менеджеров по туризму,
                    гидов, переводчиков и специалистов по обслуживанию клиентов. Каждый член
                    нашей команды обладает глубокими знаниями в своей области и страстью к путешествиям.
                </p>
            </div>

            <!-- Достижения -->
            <div class="card border-0 rounded-4 overflow-hidden mb-5 shadow">
                <div class="row g-0">
                    <div class="col-lg-8 p-4 p-lg-5">
                        <h2 class="h2 mb-4">Наши достижения</h2>
                        <div class="row">
                            <div class="col-md-6">
                                <ul class="list-unstyled">
                                    <li class="mb-3">
                                        <span class="badge bg-primary rounded-pill me-2">✓</span>
                                        Более 10 000 довольных клиентов
                                    </li>
                                    <li class="mb-3">
                                        <span class="badge bg-primary rounded-pill me-2">✓</span>
                                        Аккредитация IATA
                                    </li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <ul class="list-unstyled">
                                    <li class="mb-3">
                                        <span class="badge bg-primary rounded-pill me-2">✓</span>
                                        Премия "Быстроразвивающаяся компания 2026"
                                    </li>
                                    <li class="mb-3">
                                        <span class="badge bg-primary rounded-pill me-2">✓</span>
                                        Партнерство с ведущими туроператорами
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 bg-primary text-white p-4 p-lg-5 d-flex align-items-center">
                        <div>
                            <h3 class="h4 mb-3">Работаем с 2026</h3>
                            <p class="mb-0">Создаем незабываемые путешествия</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .divider {
        margin-top: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .square-icon {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        font-weight: bold;
        font-size: 1.25rem;
    }

    .value-number {
        font-size: 2.5rem;
        font-weight: 800;
        color: rgba(13, 110, 253, 0.1);
        line-height: 1;
    }

    .shadow-hover {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .shadow-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1) !important;
        }

    .bg-gradient-custom {
        background: linear-gradient(135deg, #0d6efd 0%, #198754 100%);
    }

    .bg-light-subtle {
        background-color: #f8f9fa;
    }

    .position-relative .position-absolute {
        z-index: -1;
    }
</style>

<footer class="border-top footer text-muted bg-light mt-5">
    <div class="container py-4">
        <div class="row align-items-center">
            <div class="col-md-6">
                &copy; 2026 - TravelAgency -
                <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none">Политика конфиденциальности</a>
            </div>
            <div class="col-md-6 text-md-end mt-3 mt-md-0">
                <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-md-end gap-2">
                    <span>Телефон: <strong>+375 (44) 796-03-06</strong></span>
                    <span class="d-none d-md-block">•</span>
                    <span>Email: <strong>info@travelagency.com</strong></span>
                </div>
            </div>
        </div>
    </div>
</footer>