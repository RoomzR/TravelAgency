@{
    ViewData["Title"] = "Конфиденциальность";
}

<div class="smooth-wrapper bg-black py-5">
    <div class="container mt-5 pt-4">
        <div class="row justify-content-center">
            <div class="col-lg-9" data-aos="fade-up">

                <div class="privacy-hero p-5 mb-5 text-center">
                    <div class="privacy-icon-glow mb-4">
                        <i class="fas fa-user-shield"></i>
                    </div>
                    <h1 class="giant-title-mini text-white mb-3">КОНФИДЕНЦИАЛЬНОСТЬ</h1>
                    <p class="text-primary-blue fw-bold letter-spacing-sm">ВАША БЕЗОПАСНОСТЬ — НАШ ГЛАВНЫЙ ПРИОРЕТЕТ</p>
                </div>

                <div class="auth-card-neon p-4 p-md-5">

                    <section class="mb-5">
                        <div class="d-flex align-items-center mb-4">
                            <div class="section-number me-3">01</div>
                            <h3 class="text-white mb-0 fw-black">СБОР ДАННЫХ</h3>
                        </div>
                        <p class="text-gray mb-4">Мы собираем только те данные, которые необходимы для качественного оформления вашего приключения. Никакого лишнего шума.</p>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="info-glass-box">
                                    <i class="fas fa-id-card text-primary-blue mb-3"></i>
                                    <h6 class="text-white">ФИО и контакты</h6>
                                    <p class="text-gray small mb-0">Для связи и идентификации личности при бронировании.</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-glass-box">
                                    <i class="fas fa-credit-card text-primary-blue mb-3"></i>
                                    <h6 class="text-white">Платежные данные</h6>
                                    <p class="text-gray small mb-0">Все транзакции защищены протоколами банковского уровня.</p>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="mb-5 pt-4 border-top-dark">
                        <div class="d-flex align-items-center mb-4">
                            <div class="section-number me-3">02</div>
                            <h3 class="text-white mb-0 fw-black">ВАШИ ПРАВА</h3>
                        </div>
                        <div class="rights-list">
                            <div class="right-item d-flex align-items-start mb-3">
                                <i class="fas fa-check-circle text-primary-blue mt-1 me-3"></i>
                                <div>
                                    <span class="text-white fw-bold d-block">Право быть забытым</span>
                                    <span class="text-gray small">Вы можете запросить полное удаление вашего профиля в любой момент.</span>
                                </div>
                            </div>
                            <div class="right-item d-flex align-items-start mb-3">
                                <i class="fas fa-check-circle text-primary-blue mt-1 me-3"></i>
                                <div>
                                    <span class="text-white fw-bold d-block">Право на исправление</span>
                                    <span class="text-gray small">Вы имеете полный доступ к редактированию данных в личном кабинете.</span>
                                </div>
                            </div>
                        </div>
                    </section>

                    <div class="alert-neon d-flex align-items-center p-4">
                        <div class="me-4 fs-2 text-primary-blue">
                            <i class="fas fa-lock"></i>
                        </div>
                        <div>
                            <p class="text-white small mb-0">Данные хранятся на защищенных серверах с использованием SSL шифрования по стандартам 2026 года. Мы заботимся о вашем цифровом следе.</p>
                        </div>
                    </div>

                    <div class="text-center mt-5">
                        <a href="/" class="btn-more text-decoration-none">
                            <i class="fas fa-arrow-left me-2"></i> ВЕРНУТЬСЯ НА ГЛАВНУЮ
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    .privacy-hero {
        background: radial-gradient(circle at center, rgba(0, 106, 255, 0.08) 0%, transparent 70%);
        border-radius: 40px;
    }

    .privacy-icon-glow {
        font-size: 4rem;
        color: #006aff;
        text-shadow: 0 0 30px rgba(0, 106, 255, 0.5);
    }

    .section-number {
        font-size: 0.8rem;
        background: #006aff;
        color: white;
        padding: 4px 10px;
        border-radius: 6px;
        font-weight: 900;
    }

    .info-glass-box {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 20px;
        padding: 25px;
        height: 100%;
        transition: 0.3s;
    }

        .info-glass-box:hover {
            background: rgba(255, 255, 255, 0.05);
            border-color: #006aff;
        }

        .info-glass-box i {
            font-size: 1.5rem;
        }

    .alert-neon {
        background: rgba(0, 106, 255, 0.05);
        border: 1px solid rgba(0, 106, 255, 0.2);
        border-radius: 20px;
    }

    .border-top-dark {
        border-top: 1px solid rgba(255, 255, 255, 0.05);
    }

    .text-gray {
        color: #86868b;
    }

    .letter-spacing-sm {
        letter-spacing: 2px;
    }
</style>