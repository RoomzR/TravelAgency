@model IEnumerable<TravelAgency.BLL.DTOs.ReviewDTO>

<div class="smooth-wrapper bg-black py-5">
    <div class="container-fluid px-lg-5">
        <h1 class="text-white fw-black mb-5 text-uppercase tracking-wider">MODERATION: REVIEWS</h1>

        <div class="chart-container-dark">
            <div class="table-responsive">
                <table class="table custom-neon-table">
                    <thead>
                        <tr class="text-gray extra-small text-uppercase">
                            <th>Клиент / Тур</th>
                            <th>Текст отзыва</th>
                            <th class="text-center">Оценка</th>
                            <th class="text-center">Статус</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var review in Model)
                        {
                            <tr>
                                <td>
                                    <div class="text-white fw-bold">@(review.ClientName ?? "Аноним")</div>
                                    <div class="text-primary-blue small">@(review.TourTitle ?? $"ID Тура: {review.TourId}")</div>
                                </td>
                                <td class="text-white-50 small" style="max-width: 300px;">
                                    @review.Text
                                </td>
                                <td class="text-center">
                                    <span class="text-warning">
                                        @for (int i = 0; i < review.Rating; i++)
                                        {
                                            <i class="fas fa-star small"></i>
                                        }
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (review.IsApproved)
                                    {
                                        <span class="badge bg-success shadow-neon-blue">Одобрен</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Ожидает</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <form asp-action="ToggleApprove" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@review.Id" />
                                        <button class="btn-login-neon py-1 px-3 small">
                                            <span>@(review.IsApproved ? "СКРЫТЬ" : "ОДОБРИТЬ")</span>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .chart-container-dark {
        background: rgba(255, 255, 255, 0.01);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 24px;
        padding: 30px;
    }

    .stats-card-blue {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(0, 106, 255, 0.1);
        padding: 25px;
        border-radius: 20px;
        position: relative;
        transition: 0.3s;
    }

        .stats-card-blue:hover {
            border-color: #006aff;
            box-shadow: 0 0 20px rgba(0, 106, 255, 0.1);
        }

        .stats-card-blue .value {
            font-size: 1.8rem;
            font-weight: 800;
            color: #ffffff;
            text-shadow: 0 0 10px rgba(255, 255, 255, 0.2);
        }

        .stats-card-blue .icon {
            position: absolute;
            right: 20px;
            bottom: 20px;
            font-size: 2.5rem;
            color: #006aff;
            opacity: 0.1;
        }

    .custom-neon-table {
        border-collapse: separate;
        border-spacing: 0 10px;
    }

        .custom-neon-table tbody tr {
            background: rgba(255, 255, 255, 0.02) !important;
            transition: transform 0.2s ease;
        }

            .custom-neon-table tbody tr:hover {
                background: rgba(0, 106, 255, 0.04) !important;
                transform: scale(1.005);
            }

        .custom-neon-table td {
            padding: 20px;
            border: none;
            vertical-align: middle;
        }

        .custom-neon-table tbody tr td:first-child {
            border-radius: 12px 0 0 12px;
        }

        .custom-neon-table tbody tr td:last-child {
            border-radius: 0 12px 12px 0;
        }

    .form-check-input {
        background-color: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.2);
        cursor: pointer;
    }

        .form-check-input:checked {
            background-color: #006aff !important;
            border-color: #006aff !important;
            box-shadow: 0 0 10px rgba(0, 106, 255, 0.5);
        }

        .form-check-input:focus {
            box-shadow: none;
            border-color: #006aff;
        }

    .btn-login-neon {
        background: transparent;
        border: 1px solid #006aff;
        color: #006aff;
        position: relative;
        overflow: hidden;
        transition: 0.3s;
        font-weight: bold;
        letter-spacing: 1px;
        text-transform: uppercase;
        font-size: 0.75rem;
        border-radius: 8px;
    }

        .btn-login-neon:hover {
            background: #006aff;
            color: white;
            box-shadow: 0 0 15px rgba(0, 106, 255, 0.4);
        }

    .badge {
        font-size: 0.65rem;
        padding: 6px 12px;
        letter-spacing: 1px;
        border-radius: 6px;
        font-weight: 700;
    }

    .shadow-neon-blue {
        box-shadow: 0 0 10px rgba(0, 210, 255, 0.3);
    }

    .text-gray {
        color: rgba(255, 255, 255, 0.4);
    }

    .extra-small {
        font-size: 0.65rem;
    }

    .tracking-wider {
        letter-spacing: 3px;
    }

    :root {
        --neon-green: #39ff14;
    }

    .text-neon-green {
        color: var(--neon-green) !important;
        text-shadow: 0 0 5px rgba(57, 255, 20, 0.3);
    }
</style>

