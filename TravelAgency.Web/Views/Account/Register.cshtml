@model TravelAgency.Web.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Регистрация";
}

<div class="auth-wrapper bg-black d-flex align-items-center justify-content-center py-5">
    <div class="container" data-aos="fade-up">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="auth-card-neon p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div class="auth-icon-circle mb-3">
                            <i class="fas fa-rocket"></i>
                        </div>
                        <h2 class="text-white fw-black letter-spacing-sm">РЕГИСТРАЦИЯ</h2>
                        <p class="text-gray small">Станьте частью сообщества первооткрывателей</p>
                    </div>

                    <form asp-action="Register" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger-neon small mb-3"></div>

                        <div class="row g-3">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="text-gray small mb-2 ms-2">Имя</label>
                                <div class="input-group-modern">
                                    <i class="fas fa-user"></i>
                                    <input asp-for="FirstName" class="modern-input w-100" placeholder="Иван" />
                                </div>
                                <span asp-validation-for="FirstName" class="text-danger-neon small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="text-gray small mb-2 ms-2">Фамилия</label>
                                <div class="input-group-modern">
                                    <i class="fas fa-signature"></i>
                                    <input asp-for="LastName" class="modern-input w-100" placeholder="Иванов" />
                                </div>
                                <span asp-validation-for="LastName" class="text-danger-neon small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="text-gray small mb-2 ms-2">Email</label>
                            <div class="input-group-modern">
                                <i class="fas fa-envelope"></i>
                                <input asp-for="Email" class="modern-input w-100" placeholder="example@mail.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger-neon small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Phone" class="text-gray small mb-2 ms-2">Телефон</label>
                            <div class="input-group-modern">
                                <i class="fas fa-phone"></i>
                                <input asp-for="Phone" class="modern-input w-100" placeholder="+375 (__) ___ __ __" />
                            </div>
                            <span asp-validation-for="Phone" class="text-danger-neon small"></span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Password" class="text-gray small mb-2 ms-2">Пароль</label>
                                <div class="input-group-modern">
                                    <i class="fas fa-key"></i>
                                    <input asp-for="Password" type="password" class="modern-input w-100" placeholder="••••••••" />
                                </div>
                                <span asp-validation-for="Password" class="text-danger-neon small"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="ConfirmPassword" class="text-gray small mb-2 ms-2">Повтор</label>
                                <div class="input-group-modern">
                                    <i class="fas fa-shield-alt"></i>
                                    <input asp-for="ConfirmPassword" type="password" class="modern-input w-100" placeholder="••••••••" />
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger-neon small"></span>
                            </div>
                        </div>

                        <div class="d-grid gap-3 pt-2">
                            <button type="submit" class="btn-login-neon py-3">
                                <span>СОЗДАТЬ АККАУНТ</span>
                            </button>
                            <div class="text-center">
                                <span class="text-gray small">Уже в системе?</span>
                                <a asp-action="Login" class="text-primary-blue fw-bold small ms-1 text-decoration-none">Войти в профиль</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Используем те же стили, что и для Login и Profile */
    .auth-wrapper {
        min-height: 90vh;
        background-color: #050505;
    }

    .auth-card-neon {
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 30px;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);
    }

    .auth-icon-circle {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, #006aff, #198754);
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: white;
        box-shadow: 0 0 20px rgba(0, 106, 255, 0.3);
    }

    .input-group-modern {
        position: relative;
    }

        .input-group-modern i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: rgba(255,255,255,0.3);
            z-index: 5;
        }

    .modern-input {
        background: rgba(255, 255, 255, 0.05) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        color: white !important;
        border-radius: 15px !important;
        padding: 12px 15px 12px 45px;
        transition: 0.3s;
    }

        .modern-input:focus {
            border-color: #006aff !important;
            box-shadow: 0 0 15px rgba(0, 106, 255, 0.2) !important;
        }

    .btn-login-neon {
        background: linear-gradient(90deg, #006aff, #198754);
        color: white;
        border: none;
        border-radius: 15px;
        font-weight: 800;
        transition: 0.4s;
    }

        .btn-login-neon:hover {
            box-shadow: 0 0 25px rgba(0, 106, 255, 0.4);
            transform: translateY(-2px);
        }

    .text-danger-neon {
        color: #ff4d4d;
        font-size: 0.75rem;
    }

    .text-gray {
        color: rgba(255,255,255,0.5);
    }

    .letter-spacing-sm {
        letter-spacing: 2px;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}