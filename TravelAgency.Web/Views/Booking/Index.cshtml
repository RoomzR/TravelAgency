@model IEnumerable<TravelAgency.BLL.DTOs.BookingDTO>
@{
    ViewData["Title"] = "Мои Бронирования";
}

<div class="smooth-wrapper bg-black py-5">
    <div class="container" data-aos="fade-up">

        <div class="d-flex align-items-center mb-5">
            <div class="profile-avatar-neon me-4">
                <i class="fas fa-suitcase-rolling"></i>
            </div>
            <div>
                <h1 class="text-white fw-black mb-0 text-uppercase">Мои путешествия</h1>
                <p class="text-primary-blue mb-0">Список всех ваших забронированных туров</p>
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="auth-card-neon p-5 text-center">
                <i class="fas fa-map-marked-alt text-gray display-1 mb-4 opacity-25"></i>
                <h3 class="text-white fw-bold">Здесь пока пусто</h3>
                <p class="text-gray mb-4">Вы еще не забронировали ни одного приключения.</p>
                <a href="@Url.Action("Index", "Tour")" class="btn-login-neon px-5 py-3 d-inline-block text-decoration-none">
                    Найти первый тур
                </a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var item in Model)
                {
                    <div class="col-12">
                        <div class="auth-card-neon p-4 tour-booking-card">
                            <div class="row align-items-center">
                                <div class="col-lg-2">
                                    <span class="text-primary-blue small fw-bold">БРОНЬ #@item.Id.ToString("D5")</span>
                                    <div class="text-white-50 small">@item.BookingDate.ToString("dd.MM.yyyy")</div>
                                </div>

                                <div class="col-lg-4">
                                    <h5 class="text-white fw-bold mb-1">@item.TourTitle</h5>
                                    <div class="d-flex gap-3">
                                        <span class="text-gray small"><i class="fas fa-user-friends me-1"></i> @item.PeopleCount чел.</span>
                                        @if (!string.IsNullOrEmpty(item.Status))
                                        {
                                            <span class="status-dot @item.Status.ToLower()"></span>
                                            <span class="text-gray small text-uppercase">@item.Status</span>
                                        }
                                    </div>
                                </div>

                                <div class="col-lg-3 text-lg-center">
                                    <div class="text-gray small">К оплате:</div>
                                    <div class="text-white fw-black h4 mb-0">@item.FinalPrice.ToString("N2") BYN</div>
                                    @if (item.DiscountAmount > 0)
                                    {
                                        <div class="text-success-neon small">Скидка: -@item.DiscountAmount?.ToString("N0") BYN</div>
                                    }
                                </div>

                                <div class="col-lg-3 text-end">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <a href="@Url.Action("Details", "Tours", new { id = item.TourId })" class="btn-outline-neon py-2 px-3 small">
                                            <i class="fas fa-info-circle"></i>
                                        </a>

                                        @if (item.Status == "Pending")
                                        {
                                            <form asp-action="Cancel" method="post" onsubmit="return confirm('Вы действительно хотите отменить бронирование?')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-outline-danger rounded-pill px-4">
                                                    Отмена
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    .tour-booking-card {
        transition: transform 0.3s ease, border-color 0.3s ease;
        border: 1px solid rgba(255,255,255,0.05);
    }

        .tour-booking-card:hover {
            transform: translateX(10px);
            border-color: rgba(0, 106, 255, 0.3);
        }

    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
        align-self: center;
        margin-right: 5px;
    }

        .status-dot.pending {
            background: #ffc107;
            box-shadow: 0 0 10px #ffc107;
        }

        .status-dot.confirmed {
            background: #00ff88;
            box-shadow: 0 0 10px #00ff88;
        }

        .status-dot.cancelled {
            background: #ff4d4d;
            box-shadow: 0 0 10px #ff4d4d;
        }

    .btn-outline-danger {
        border: 1px solid rgba(255, 77, 77, 0.3);
        color: #ff4d4d;
        background: transparent;
        font-size: 0.8rem;
        font-weight: bold;
        transition: 0.3s;
    }

        .btn-outline-danger:hover {
            background: #ff4d4d;
            color: white;
            box-shadow: 0 0 15px rgba(255, 77, 77, 0.4);
        }
</style>