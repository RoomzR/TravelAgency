@model IEnumerable<TravelAgency.BLL.DTOs.BookingDTO>
@{
    ViewData["Title"] = "Мои Бронирования";
}

<div class="smooth-wrapper bg-black py-5">
    <div class="container" data-aos="fade-up">

        <div class="d-flex align-items-center mb-5">
            <div class="profile-avatar-neon me-4">
                <i class="fas fa-suitcase-rolling"></i>
            </div>
            <div>
                <h1 class="text-white fw-black mb-0 text-uppercase">Мои путешествия</h1>
                <p class="text-primary-blue mb-0 small">Список ваших бронирований и связь с менеджером</p>
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="auth-card-neon p-5 text-center">
                <i class="fas fa-map-marked-alt text-gray display-1 mb-4 opacity-25"></i>
                <h3 class="text-white fw-bold">Здесь пока пусто</h3>
                <p class="text-gray mb-4">Вы еще не забронировали ни одного приключения.</p>
                <a href="@Url.Action("Index", "Tour")" class="btn-login-neon px-5 py-3 d-inline-block text-decoration-none">
                    Найти первый тур
                </a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var item in Model)
                {
                    <div class="col-12">
                        <div class="auth-card-neon p-4 tour-booking-card">
                            <div class="row align-items-center">
                                <div class="col-lg-2">
                                    <span class="text-primary-blue small fw-bold">БРОНЬ #@item.Id.ToString("D5")</span>
                                    <div class="text-white-50 small">@item.BookingDate.ToString("dd.MM.yyyy")</div>
                                </div>

                                <div class="col-lg-4">
                                    <h5 class="text-white fw-bold mb-1">@item.TourTitle</h5>
                                    <div class="d-flex gap-3 align-items-center">
                                        <span class="text-gray small"><i class="fas fa-user-friends me-1"></i> @item.PeopleCount чел.</span>
                                        @if (!string.IsNullOrEmpty(item.Status))
                                        {
                                            <div class="d-flex align-items-center">
                                                <span class="status-dot @item.Status.ToLower()"></span>
                                                <span class="text-gray small text-uppercase fw-bold" style="font-size: 0.7rem;">@item.Status</span>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="col-lg-3 text-lg-center">
                                    <div class="text-white fw-black h4 mb-0">@item.FinalPrice.ToString("N2") BYN</div>
                                    @if (item.DiscountAmount > 0)
                                    {
                                        <div class="text-success-neon extra-small">Скидка: -@item.DiscountAmount?.ToString("N0") BYN</div>
                                    }
                                </div>

                                <div class="col-lg-3 text-end">
                                    <div class="d-flex gap-2 justify-content-end align-items-center">
                                        <button class="btn-chat-neon" type="button" data-bs-toggle="collapse" data-bs-target="#chat-@item.Id">
                                            <div class="icon-wrapper">
                                                <i class="fas fa-comment-dots"></i>
                                                <span class="notification-badge"></span> 
                                            </div>
                                            <span>СВЯЗЬ</span>
                                        </button>

                                        <a href="@Url.Action("Details", "Tour", new { id = item.TourId })" class="btn-outline-neon py-2 px-3 small">
                                            <i class="fas fa-eye"></i>
                                        </a>

                                        @if (item.Status == "Pending")
                                        {
                                            <form asp-action="Cancel" method="post" onsubmit="return confirm('Вы действительно хотите отменить бронирование?')" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn-outline-danger px-3 py-2 small rounded-pill">
                                                    ОТМЕНА
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="collapse" id="chat-@item.Id">
                                <div class="mt-4 pt-4 border-top-dark">
                                    <div class="row g-4">
                                        <div class="col-md-7">
                                            <div class="chat-history-box p-3">
                                                <label class="text-primary-blue extra-small fw-black mb-3 text-uppercase">История сообщений</label>

                                                @if (!string.IsNullOrEmpty(item.Comments))
                                                {
                                                    <div class="message-bubble user-msg mb-3">
                                                        <small class="text-primary-blue d-block fw-bold">Ваш вопрос/пожелание:</small>
                                                        @item.Comments
                                                    </div>
                                                }

                                                @if (!string.IsNullOrEmpty(item.ManagerComments))
                                                {
                                                    <div class="message-bubble manager-msg">
                                                        <small class="text-success-neon d-block fw-bold">Ответ менеджера:</small>
                                                        @item.ManagerComments
                                                        @if (!string.IsNullOrEmpty(item.ManagerName))
                                                        {
                                                            <div class="text-end mt-1 extra-small opacity-50">Менеджер: @item.ManagerName</div>
                                                        }
                                                    </div>
                                                }
                                                else if (string.IsNullOrEmpty(item.Comments))
                                                {
                                                    <div class="text-center py-4 text-gray small italic">Здесь будет ваша переписка с менеджером</div>
                                                }
                                            </div>
                                        </div>

                                        <div class="col-md-5">
                                            <form asp-action="UpdateComments" asp-controller="Booking" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="bookingId" value="@item.Id" />
                                                <label class="text-white extra-small fw-black mb-2 text-uppercase">Написать сообщение</label>
                                                <textarea name="newComment" class="form-control bg-dark border-secondary text-white small mb-2" rows="3" placeholder="Введите ваш вопрос..."></textarea>
                                                <button type="submit" class="btn-login-neon w-100 py-2 small">Отправить</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>

    button.btn-chat-neon {
        appearance: none !important;
        -webkit-appearance: none !important;
        outline: none !important;
        box-shadow: none !important;
        border: none;
        background: none;
    }

    .smooth-wrapper .btn-chat-neon {
        background-color: rgba(0, 106, 255, 0.15) !important;
        border: 1px solid #006aff !important;
        color: #006aff !important;
        padding: 10px 22px !important;
        border-radius: 12px !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 10px !important;
        font-size: 0.75rem !important;
        font-weight: 800 !important;
        letter-spacing: 1.2px !important;
        text-transform: uppercase !important;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
        position: relative !important;
        overflow: hidden !important;
        cursor: pointer !important;
    }


        .smooth-wrapper .btn-chat-neon:hover {
            background-color: #006aff !important;
            color: #ffffff !important;
            box-shadow: 0 0 20px rgba(0, 106, 255, 0.6) !important;
            transform: translateY(-2px) !important;
        }

        .smooth-wrapper .btn-chat-neon[aria-expanded="true"] {
            background-color: rgba(0, 255, 136, 0.2) !important;
            border-color: #00ff88 !important;
            color: #00ff88 !important;
        }

    .btn-chat-neon .icon-wrapper {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        position: relative !important;
    }

    .notification-badge {
        position: absolute !important;
        top: -4px !important;
        right: -4px !important;
        width: 8px !important;
        height: 8px !important;
        background-color: #00ff88 !important;
        border-radius: 50% !important;
        box-shadow: 0 0 10px #00ff88 !important;
        animation: pulse-green-neon 2s infinite !important;
        z-index: 2 !important;
    }

    @@keyframes pulse-green-neon {
        0% {
            transform: scale(0.9);
            opacity: 0.7;
        }

        50% {
            transform: scale(1.3);
            opacity: 1;
            box-shadow: 0 0 15px #00ff88;
        }

        100% {
            transform: scale(0.9);
            opacity: 0.7;
        }
    }

    .tour-booking-card {
        background: #111111 !important;
        border: 1px solid rgba(255,255,255,0.1) !important;
        border-radius: 20px !important;
    }

    .chat-history-box {
        background: rgba(255,255,255,0.03);
        border-radius: 15px;
        padding: 20px;
    }

    .user-msg {
        background: rgba(0, 106, 255, 0.1);
        border-left: 4px solid #006aff;
        padding: 10px;
        border-radius: 8px;
        color: #fff;
    }

    .manager-msg {
        background: rgba(0, 255, 136, 0.1);
        border-left: 4px solid #00ff88;
        padding: 10px;
        border-radius: 8px;
        color: #fff;
    }

    .status-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 8px;
    }

        .status-dot.pending {
            background: #ffc107;
            box-shadow: 0 0 10px #ffc107;
        }

        .status-dot.confirmed {
            background: #00ff88;
            box-shadow: 0 0 10px #00ff88;
        }

        .status-dot.cancelled {
            background: #ff4d4d;
            box-shadow: 0 0 10px #ff4d4d;
        }
</style>